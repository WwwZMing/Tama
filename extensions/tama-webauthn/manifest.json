{
  "manifest_version": 3,
  "name": "Tama Passkey Bridge",
  "version": "0.2.0",
  "description": "Use Tama passkeys on any website. Creates/uses passkeys stored in Tama (Windows Hello verified) via the system native messaging channel.",
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["content-isolated.js"],
      "run_at": "document_start"
    }
  ],
  "background": {
    "service_worker": "background.js"
  },
  "permissions": ["nativeMessaging"],
  "web_accessible_resources": [
    {
      "resources": ["content-main.js"],
      "matches": ["http://*/*", "https://*/*"]
    }
  ]
}
