<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
      Tama 的视觉系统：一套 token + 少量类样式。
      两套配色都放在 ThemeDictionaries 里，跟随系统主题时不需要任何 JS/首帧补丁
      （Blazor 版要在电路起来之前用脚本上色，Avalonia 里 XAML 一加载就是最终颜色）。
    -->

    <Styles.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>

                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="TamaBgBrush" Color="#0B0B10" />
                    <SolidColorBrush x:Key="TamaSurfaceBrush" Color="#121219" />
                    <SolidColorBrush x:Key="TamaCardBrush" Color="#121219" />
                    <SolidColorBrush x:Key="TamaBorderBrush" Color="#262633" />
                    <SolidColorBrush x:Key="TamaTextBrush" Color="#ECECF2" />
                    <SolidColorBrush x:Key="TamaMutedBrush" Color="#9A9AA8" />
                    <SolidColorBrush x:Key="TamaAccentBrush" Color="#6366F1" />
                    <SolidColorBrush x:Key="TamaAccentAltBrush" Color="#8B5CF6" />
                    <SolidColorBrush x:Key="TamaAccentSoftBrush" Color="#2A2A4A" />
                    <SolidColorBrush x:Key="TamaDangerBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="TamaWarnBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="TamaOkBrush" Color="#34D399" />
                    <SolidColorBrush x:Key="TamaOkSoftBrush" Color="#2234D399" />
                    <SolidColorBrush x:Key="TamaWarnSoftBrush" Color="#22FBBF24" />
                    <SolidColorBrush x:Key="TamaDangerSoftBrush" Color="#2AF87171" />
                    <!-- 手机列表"选中=展开"，整块铺 accent-soft 太重，单独压一档 -->
                    <SolidColorBrush x:Key="TamaSelectedBrush" Color="#1F6366F1" />
                    <!-- iOS "inset grouped" 风格：容器只比画布高一档，靠分隔线切行，不靠边框 -->
                    <SolidColorBrush x:Key="TamaGroupedBrush" Color="#14141B" />
                    <SolidColorBrush x:Key="TamaSeparatorBrush" Color="#26FFFFFF" />

                    <!-- 玻璃层：只在"窗口能透出系统背景"（Windows Mica）时才用，
                         值带 alpha，透过去的是壁纸而不是内容——Android 没有背景模糊 API，
                         那边走不透明兜底（见 Grid.shellroot 的默认样式）。 -->
                    <SolidColorBrush x:Key="TamaGlassSurfaceBrush" Color="#CC121219" />
                    <!-- 移动端顶栏 / 底栏：留一点点透，配描边与阴影读作"浮动条" -->
                    <SolidColorBrush x:Key="TamaBarBrush" Color="#E6121219" />
                </ResourceDictionary>

                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="TamaBgBrush" Color="#F5F5FA" />
                    <SolidColorBrush x:Key="TamaSurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TamaCardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TamaBorderBrush" Color="#E1E1EC" />
                    <SolidColorBrush x:Key="TamaTextBrush" Color="#16161D" />
                    <SolidColorBrush x:Key="TamaMutedBrush" Color="#66667A" />
                    <SolidColorBrush x:Key="TamaAccentBrush" Color="#4F46E5" />
                    <SolidColorBrush x:Key="TamaAccentAltBrush" Color="#7C3AED" />
                    <SolidColorBrush x:Key="TamaAccentSoftBrush" Color="#E7E7FB" />
                    <SolidColorBrush x:Key="TamaDangerBrush" Color="#DC2626" />
                    <SolidColorBrush x:Key="TamaWarnBrush" Color="#B45309" />
                    <SolidColorBrush x:Key="TamaOkBrush" Color="#059669" />
                    <SolidColorBrush x:Key="TamaOkSoftBrush" Color="#1A059669" />
                    <SolidColorBrush x:Key="TamaWarnSoftBrush" Color="#1AB45309" />
                    <SolidColorBrush x:Key="TamaDangerSoftBrush" Color="#1ADC2626" />
                    <SolidColorBrush x:Key="TamaSelectedBrush" Color="#99E7E7FB" />
                    <SolidColorBrush x:Key="TamaGroupedBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TamaSeparatorBrush" Color="#14000000" />
                    <SolidColorBrush x:Key="TamaGlassSurfaceBrush" Color="#CCFFFFFF" />
                    <SolidColorBrush x:Key="TamaBarBrush" Color="#E6FFFFFF" />
                </ResourceDictionary>

            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- === 基础 === -->

    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource TamaBgBrush}" />
        <Setter Property="FontFamily" Value="{StaticResource ContentControlThemeFontFamily}" />
    </Style>

    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono,Consolas,Menlo,monospace" />
    </Style>

    <Style Selector="TextBlock.error">
        <Setter Property="Foreground" Value="{DynamicResource TamaDangerBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <!-- === 容器 === -->

    <!-- 外壳分层。默认（Android / 无 Mica 的环境）全部不透明，行为与之前一模一样；
         窗口拿到 Mica 时由 MainWindow 加 .mica 类，根网格与侧栏/条让出背景，
         内容区（Grid.pagearea）仍然不透明——这是 Windows 11 设置页的做法：
         壁纸只从侧栏与边框区域透出来，正文该多清楚还多清楚。 -->
    <Style Selector="Grid.shellroot">
        <Setter Property="Background" Value="{DynamicResource TamaBgBrush}" />
    </Style>

    <!-- 内容区与侧栏用**同一块画布色**：之前侧栏用 surface（比底色浅一档）、内容区用 bg，
         叠上卡片和卡片里的子卡片，整个窗口像"千层蛋糕"。现在底色只有一层，
         层次靠卡片描边和间距表达，不靠堆不同深浅的填充。 -->
    <Style Selector="Grid.pagearea">
        <Setter Property="Background" Value="{DynamicResource TamaBgBrush}" />
    </Style>

    <Style Selector="Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource TamaBgBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaBorderBrush}" />
    </Style>

    <Style Selector="Border.topbar">
        <Setter Property="Background" Value="{DynamicResource TamaBarBrush}" />
    </Style>

    <Style Selector="Border.bottombar">
        <Setter Property="Background" Value="{DynamicResource TamaBarBrush}" />
    </Style>

    <!-- === Mica（Windows 11）：真·背景模糊，透出来的是桌面壁纸 === -->
    <Style Selector="Window.mica">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Window.mica Grid.shellroot">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Window.mica Border.sidebar">
        <Setter Property="Background" Value="{DynamicResource TamaGlassSurfaceBrush}" />
    </Style>

    <Style Selector="Window.mica Border.topbar">
        <Setter Property="Background" Value="{DynamicResource TamaGlassSurfaceBrush}" />
    </Style>

    <Style Selector="Window.mica Border.bottombar">
        <Setter Property="Background" Value="{DynamicResource TamaGlassSurfaceBrush}" />
    </Style>

    <!-- 提示条：浮在页面顶部（不占布局行），按语气上色。
         之前是一条灰卡片贴在底部：既挡底栏，又完全看不出"这是成功还是失败"。 -->
    <Style Selector="Border.toast">
        <!-- 底盘要不透明：soft 色带 alpha，文字会从底下透出来（实测"看着很脏"） -->
        <Setter Property="Background" Value="{DynamicResource TamaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="BoxShadow" Value="0 6 20 0 #66000000" />
    </Style>

    <Style Selector="Border.toast.ok">
        <Setter Property="BorderBrush" Value="{DynamicResource TamaOkBrush}" />
    </Style>

    <Style Selector="Border.toast.err">
        <Setter Property="BorderBrush" Value="{DynamicResource TamaDangerBrush}" />
    </Style>

    <Style Selector="Border.toast TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="FontSize" Value="12" />
    </Style>

    <Style Selector="Border.toast Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaAccentBrush}" />
    </Style>

    <Style Selector="Border.toast.ok TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TamaOkBrush}" />
    </Style>

    <Style Selector="Border.toast.ok Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaOkBrush}" />
    </Style>

    <Style Selector="Border.toast.err TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TamaDangerBrush}" />
    </Style>

    <Style Selector="Border.toast.err Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaDangerBrush}" />
    </Style>

    <!-- 浮层里的对话框：桌面居中，手机贴底成抽屉 -->
    <Style Selector="ContentControl.overlay">
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="24" />
    </Style>

    <Style Selector="ContentControl.overlay.sheet">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Bottom" />
        <Setter Property="Margin" Value="0" />
    </Style>

    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource TamaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <Style Selector="Border.panel">
        <Setter Property="Background" Value="{DynamicResource TamaCardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="14" />
    </Style>

    <!-- === 按钮 === -->

    <Style Selector="Button">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>

    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="18,10" />
    </Style>

    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TamaAccentAltBrush}" />
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <!-- Fluent 会在 hover 时用主题资源覆盖背景，这里显式钉住 Foreground，否则暗色底上字会变黑 -->
    <Style Selector="Button.primary /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="White" />
    </Style>

    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
    </Style>

    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
    </Style>

    <Style Selector="Button.danger">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaDangerBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TamaDangerBrush}" />
    </Style>

    <Style Selector="Button.nav">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <Style Selector="Button.nav.on">
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style Selector="Button.chip">
        <Setter Property="Padding" Value="10,5" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <Style Selector="Button.chip.on">
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
    </Style>

    <Style Selector="Button.chip:disabled">
        <Setter Property="Opacity" Value="0.35" />
    </Style>

    <!-- Fluent 的 ContentPresenter 自己带主题前景色，光设 Button.Foreground 不生效（实测：选中态的字发暗）。
         凡是"底色被我们换掉"的按钮都得把前景钉在模板部件上。 -->
    <Style Selector="Button.chip /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <Style Selector="Button.chip.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TamaTextBrush}" />
    </Style>

    <Style Selector="Button.nav.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TamaTextBrush}" />
    </Style>

    <!-- === 图标（线框）===
         图标是 Material Design Icons 的填充路径（见 Icons.cs），统一用 Fill 上色，
         不依赖任何图标字体（Android 上没有 Segoe Fluent Icons，字体方案会掉成豆腐块）。 -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="17" />
        <Setter Property="Height" Value="17" />
        <Setter Property="Stretch" Value="Uniform" />
        <!-- MDI 是 24x24 的填充路径，用 Fill；写 Stroke 会描出外轮廓（看起来像空心怪东西） -->
        <Setter Property="Fill" Value="{DynamicResource TamaMutedBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="Path.icon.strong">
        <Setter Property="Fill" Value="{DynamicResource TamaTextBrush}" />
    </Style>

    <!-- 选中的导航项：图标跟着文字一起提亮（只改文字会导致"图标还是灰的"） -->
    <Style Selector="Button.nav.on Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaAccentBrush}" />
    </Style>

    <!-- 侧栏分组标题：小字号 + 字重 + 弱化，靠间距分组而不是分割线 -->
    <Style Selector="TextBlock.navgroup">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
        <Setter Property="Opacity" Value="0.7" />
        <Setter Property="Margin" Value="12,0,0,6" />
    </Style>

    <!-- 手机底部 Tab：6 等分，触控高度 ≥48（桌面上的 34 太矮，手指点不准） -->
    <Style Selector="Button.tab">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="2,2" />
        <!-- 最小的触控高度；不写死 Height，让内容（图标+文字）永远装得下 -->
        <Setter Property="MinHeight" Value="48" />
        <Setter Property="FontSize" Value="10.5" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <!-- 默认状态图标跟文字同一个灰；选中才提亮成主色（只改文字会导致"图标还是灰的"） -->
    <Style Selector="Button.tab Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <Style Selector="Button.tab.on">
        <Setter Property="Foreground" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
    </Style>

    <Style Selector="Button.tab.on Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaAccentBrush}" />
    </Style>

    <Style Selector="Button.tab /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <Style Selector="Button.tab.on /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="TextElement.Foreground" Value="{DynamicResource TamaAccentBrush}" />
    </Style>

    <!-- === 输入 === -->

    <Style Selector="TextBox.field">
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Padding" Value="12,9" />
        <Setter Property="MinHeight" Value="38" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Background" Value="{DynamicResource TamaSurfaceBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource TamaBorderBrush}" />
    </Style>

    <!-- === 列表 === -->

    <Style Selector="ListBox.tama">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <!-- 行内状态标签：文件夹 / 已同步 / 待同步。颜色只承担语义（绿=正常、黄=待处理、紫=分类）。 -->
    <Style Selector="Border.tag">
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Padding" Value="7,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <Style Selector="ListBox.tama ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,6" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="ListBox.tama ListBoxItem:selected /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
    </Style>

    <!-- 手机上"选中"等于"展开"，整块铺满 accent-soft 会变成一块紫色面板（截图实测很闷），
         所以窄屏单独用更淡的一档 -->
    <Style Selector="Grid.mobile ListBox.tama ListBoxItem:selected /template/ ContentPresenter">
        <!-- 手机上"选中"就是"展开"，再铺一层底色就变成"面板套内容"。
             展开本身已经由下面的字段内容表达，这里保持透明。 -->
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
    </Style>

    <Style Selector="Slider">
        <Setter Property="Foreground" Value="{DynamicResource TamaAccentBrush}" />
    </Style>

    <!-- ==================== 触控（仅窄屏壳：Grid.mobile） ====================
         桌面 34 高的按钮是对的（鼠标精确），手机上 34dp 手指点不准；
         反过来把桌面也放大只会让桌面变笨重。所以整组只挂在外壳的 mobile 类下。 -->

    <!-- 尺寸口径改成"内容密度优先"：不再为手指把每个控件撑到 44dp。
         列表+详情同屏时，按钮一大就把内容挤没了（用户实测："按钮巨大无比"）。
         视觉 36 高、字号 12.5，靠 pressed 反馈与水平留白保证可点。 -->
    <Style Selector="Grid.mobile Button">
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="12,4" />
        <Setter Property="FontSize" Value="12.5" />
    </Style>

    <Style Selector="Grid.mobile Button.chip">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="10,3" />
        <Setter Property="CornerRadius" Value="13" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!-- 分组列表行：纵向 11 → 7 -->
    <Style Selector="Grid.mobile Button.row">
        <Setter Property="Padding" Value="14,7" />
        <Setter Property="MinHeight" Value="38" />
    </Style>

    <Style Selector="Grid.mobile Button.tab">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Padding" Value="2,2" />
    </Style>

    <Style Selector="Grid.mobile Button.ghost">
        <Setter Property="Padding" Value="12,7" />
    </Style>

    <Style Selector="Grid.mobile TextBox.field">
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Padding" Value="10,6" />
        <Setter Property="FontSize" Value="13" />
    </Style>

    <Style Selector="Grid.mobile ListBox.tama ListBoxItem">
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="Margin" Value="0,0,0,3" />
    </Style>

    <!-- "复制/查看"这类行内动作：它们是**字段的附属操作**，不该跟主操作抢视觉重量。
         手机上如果每个字段右边都站一个 36 高的按钮，一屏四个字段就被按钮填满了
         （用户实测："复制删除等动作"太占地方）。做成小号文字操作，颜色用主色表示可点。 -->
    <Style Selector="Button.copy">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Foreground" Value="{DynamicResource TamaAccentBrush}" />
    </Style>

    <Style Selector="Grid.mobile Button.copy">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="7,1" />
        <Setter Property="FontSize" Value="11" />
    </Style>

    <!-- 按压反馈：Fluent 的 hover 在触屏上没有意义，pressed 才是手指能感知到的那个；
         没有它按钮点下去像没反应（这就是"完全没触控优化"的观感来源之一）。 -->
    <Style Selector="Grid.mobile Button:pressed">
        <Setter Property="Opacity" Value="0.55" />
    </Style>

    <Style Selector="Grid.mobile Button.tab:pressed">
        <Setter Property="Opacity" Value="0.75" />
    </Style>

    <Style Selector="Grid.mobile ListBox.tama ListBoxItem:pressed /template/ ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TamaAccentSoftBrush}" />
    </Style>

    <!-- === 手机"就地展开"的详情：压平成一条，不要容器套容器 ===
         行里已经写着名称/文件夹/同步状态，展开区只该补字段。所以：
         外框退成一条 1px 上分隔线，字段块退成纯排版（无底、无边框、无圆角）。
         桌面右栏仍走 Border.panel / Border.card 那套卡片（那边空间够，分组反而有用）。 -->
    <Style Selector="Border.panel.inline">
        <!-- 目标：展开的字段看起来"本来就在页面上"，而不是弹出来的一块。
             所以无底色、无边框、无圆角，只留左缩进与间距。 -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,4,0,0" />
    </Style>

    <Style Selector="Border.card.inline">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Padding" Value="0,6" />
    </Style>

    <Style Selector="StackPanel.actions.inline">
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>


    <!-- === 行内文字操作（复制 / 收藏 / 编辑 / 删除）===
         它们不是"按钮"，是字段旁边的动作入口：无底、无框、小字号。
         放在文件末尾是为了盖住前面 Grid.mobile Button 的 36 高规则
         （Avalonia 按定义顺序覆盖，不按选择器权重）。 -->
    <Style Selector="Button.action">
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Padding" Value="8,3" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TamaAccentBrush}" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
    </Style>

    <Style Selector="Button.action.muted">
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

    <Style Selector="Button.action.danger">
        <Setter Property="Foreground" Value="{DynamicResource TamaDangerBrush}" />
        <!-- Button.danger 自带 1px 红框（桌面大按钮用的），行内文字操作不要框 -->
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style Selector="Grid.mobile Button.action">
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="8,1" />
        <Setter Property="FontSize" Value="12" />
    </Style>


    <!-- === 排版（Apple: 字距随字号变，行距与字号反比）===
         大标题收紧（负字距 + 紧行距），小标签放松（正字距）才有易读性。 -->
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="LetterSpacing" Value="-0.4" />
        <Setter Property="LineHeight" Value="26" />
    </Style>

    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="LetterSpacing" Value="-0.2" />
        <Setter Property="LineHeight" Value="20" />
    </Style>

    <!-- 字段标签：11.5 + 正字距，弱化成注脚 -->
    <Style Selector="TextBlock.fieldlabel">
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="LetterSpacing" Value="0.3" />
        <Setter Property="Foreground" Value="{DynamicResource TamaMutedBrush}" />
        <Setter Property="Margin" Value="0,0,0,2" />
    </Style>

    <!-- 字段值：15，字距略收，行距放宽 -->
    <Style Selector="TextBlock.fieldvalue">
        <Setter Property="FontSize" Value="15" />
        <Setter Property="LetterSpacing" Value="-0.1" />
        <Setter Property="LineHeight" Value="20" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>


    <!-- === iOS inset grouped list ===
         一行行排在一个轻微抬升的容器里，行与行之间用**内缩的分隔线**切开；
         不做"每行一张卡片"。这是 Apple 设置页的基本形。 -->
    <Style Selector="Border.grouped">
        <Setter Property="Background" Value="{DynamicResource TamaGroupedBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="ClipToBounds" Value="True" />
    </Style>

    <Style Selector="Border.separator">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{DynamicResource TamaSeparatorBrush}" />
        <Setter Property="Margin" Value="14,0,0,0" />
    </Style>

    <!-- 列表行：整行可点，左图标 + 文字，通高 -->
    <Style Selector="Button.row">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="14,11" />
        <Setter Property="MinHeight" Value="44" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource TamaTextBrush}" />
    </Style>

    <!-- 危险行只换文字颜色：Button.danger 自带 1px 红框（桌面大按钮用的），
         套在列表行上会凭空多出一个方框 -->
    <Style Selector="Button.row.danger">
        <Setter Property="Foreground" Value="{DynamicResource TamaDangerBrush}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!-- 列表行不要焦点框：一出现就是"凭空多出一个方框"，破坏 inset grouped 的干净边缘 -->
    <Style Selector="Button.row">
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.row:focus /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <!-- 行高亮要贴住容器边缘（直角），否则分组容器里会浮出一块圆角色块 -->
    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.row:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="CornerRadius" Value="0" />
    </Style>

    <Style Selector="Button.row:pressed /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource TamaSeparatorBrush}" />
    </Style>


    <!-- Apple: 按下即反馈，用 scale(0.97) 而不是变淡（变淡像禁用） -->
    <Style Selector="Grid.mobile Button">
        <Setter Property="RenderTransform" Value="none" />
        <Setter Property="Transitions">
            <Transitions>
                <TransformOperationsTransition Property="RenderTransform" Duration="0:0:0.1" />
            </Transitions>
        </Setter>
    </Style>

    <Style Selector="Grid.mobile Button:pressed">
        <Setter Property="Opacity" Value="1" />
        <Setter Property="RenderTransform" Value="scale(0.97)" />
    </Style>

    <Style Selector="Grid.mobile Button.row:pressed">
        <Setter Property="RenderTransform" Value="none" />
    </Style>


    <!-- === 行尾的展开/收起箭头 ===
         它本身就是按钮（展开时朝上、点了收起），所以不需要在底部再摆一个大"收起"。
         尺寸写死 28 并放在文件末尾，才压得住 Grid.mobile Button 的 36 高。 -->
    <Style Selector="Button.chevron">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="MinHeight" Value="0" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="FocusAdorner" Value="{x:Null}" />
    </Style>

    <Style Selector="Button.chevron Path.icon">
        <Setter Property="Fill" Value="{DynamicResource TamaMutedBrush}" />
    </Style>

</Styles>
