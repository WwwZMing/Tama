<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:root="using:Tama.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.SettingsView"
             x:DataType="vm:SettingsViewModel">

    <!-- pagepane：手机上给滚动内容末尾留出底栏的空白（样式见 Styles/Tama.axaml，桌面不受影响） -->
    <ScrollViewer>
        <StackPanel Classes="pagepane" Spacing="14">

            <TextBlock Text="设置" Classes="h1" />

            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

            <!-- ==================== 数据备份（放第一个：手机上不用滚就能看到） ====================
                 导出与还原**同一张卡片**：它们是同一个操作的正反两面，分开就会出现
                 "导出在这儿、导入找不着"（用户报的就是这个）。 -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="数据备份" Classes="h2" />
                    <TextBlock Text="明文 JSON（含全部密码与通行密钥），导出时会让你选保存位置。"
                               Classes="muted" />

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="secondary" Content="导出为 JSON" Command="{Binding ExportTamaCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Classes="secondary" Content="导出给 Bitwarden" Command="{Binding ExportBitwardenCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                    </StackPanel>

                    <TextBlock Text="Bitwarden 格式可在官网「工具 → 导入数据」直接导入；单向，通行密钥与标签不会带过去。"
                               Classes="muted" />

                    <!-- 从备份还原 -->
                    <Border Classes="inset" Margin="0,4,0,0">
                        <StackPanel Spacing="8">
                            <TextBlock Text="从备份还原" FontWeight="SemiBold" FontSize="13" />
                            <TextBlock Text="还原上面导出的 tama-export-*.json（密码与通行密钥私钥都在里面）。"
                                       Classes="muted" />

                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <Button Classes="secondary" Content="选择备份文件…"
                                        Command="{Binding PickBackupCommand}" IsEnabled="{Binding !IsBusy}" />
                                <Button Classes="chip" Content="取消" Command="{Binding ClearPreviewCommand}"
                                        IsVisible="{Binding ShowPreview}" />
                            </StackPanel>

                            <!-- 预览标题：认不出文件时也照样显示（按错误色），下面则不再给复选框和按钮 ——
                                 一颗永远灰着的"开始还原"只会让人以为功能又坏了。 -->
                            <TextBlock Text="{Binding PreviewTitle}" FontSize="12" TextWrapping="Wrap"
                                       Margin="0,2,0,0" IsVisible="{Binding HasPreview}"
                                       Classes.error="{Binding ShowInvalidPreview}" />

                            <!-- 预览：先看清是什么再决定导不导 -->
                            <StackPanel Spacing="6" IsVisible="{Binding CanPreviewRestore}" Margin="0,0,0,0">
                                <TextBlock Text="{Binding PreviewTypes}" Classes="muted"
                                           IsVisible="{Binding PreviewTypes, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding PreviewFolders}" Classes="muted" TextWrapping="Wrap"
                                           IsVisible="{Binding PreviewFolders, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                                <CheckBox Content="还原文件夹" IsChecked="{Binding RestoreFolders}" FontSize="12" />
                                <CheckBox Content="跳过重复条目（同类型 + 同名称 + 同用户名）"
                                          IsChecked="{Binding SkipDuplicates}" FontSize="12" />

                                <Button Classes="primary" Content="开始还原" HorizontalAlignment="Left"
                                        Command="{Binding RestoreCommand}" IsEnabled="{Binding CanRestore}" />
                            </StackPanel>

                            <!-- 进行中：逐条落库 + 有账号时逐条推送，大库要好几秒。没有这句话，
                                 点下去就是"看起来什么都没发生"（用户报的另一半）。 -->
                            <TextBlock Text="正在还原，逐条写入本地库…" Classes="muted"
                                       IsVisible="{Binding IsRestoring}" />

                            <!-- 完成态（真有新增）：绿底 + 对勾 + 一句话 + 数量，**留在原地**，
                                 不靠一条几秒就消失的提示条。预览同时收起，杜绝连点还原。 -->
                            <Border Classes="inset" IsVisible="{Binding ShowRestoreSuccess}"
                                    Background="{DynamicResource TamaOkSoftBrush}" Padding="12,10">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{x:Static root:Icons.Check}" Width="14" Height="14"
                                              Fill="{DynamicResource TamaOkBrush}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RestoreSummary}" FontWeight="SemiBold" FontSize="13"
                                                   Foreground="{DynamicResource TamaOkBrush}" VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RestoreDetail}" Classes="muted" TextWrapping="Wrap"
                                               IsVisible="{Binding RestoreDetail, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="ghost" Content="完成" HorizontalAlignment="Left"
                                            Command="{Binding ClearPreviewCommand}" />
                                </StackPanel>
                            </Border>

                            <!-- 完成态（跑了但一条没进）：同样的位置、中性配色。给绿色会骗人。 -->
                            <Border Classes="inset" IsVisible="{Binding ShowRestoreNone}" Padding="12,10">
                                <StackPanel Spacing="5">
                                    <StackPanel Orientation="Horizontal" Spacing="6">
                                        <Path Classes="icon" Data="{x:Static root:Icons.Info}" Width="14" Height="14"
                                              VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding RestoreSummary}" FontWeight="SemiBold" FontSize="13"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                    <TextBlock Text="{Binding RestoreDetail}" Classes="muted" TextWrapping="Wrap"
                                               IsVisible="{Binding RestoreDetail, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                    <Button Classes="ghost" Content="完成" HorizontalAlignment="Left"
                                            Command="{Binding ClearPreviewCommand}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!-- 别的密码管理器：KeePass 走单独入口（要密码 + 分组预览） -->
                    <TextBlock Text="从别的密码管理器迁移？" Classes="muted" Margin="0,4,0,0" />
                    <Button Classes="secondary" Content="KeePass (.kdbx) 导入" HorizontalAlignment="Left"
                            Command="{Binding ImportKdbxCommand}" IsEnabled="{Binding !IsBusy}" />

                    <TextBlock Text="数据目录" Classes="muted" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding DataDir}" Classes="mono" FontSize="11" TextWrapping="Wrap" />
                </StackPanel>
            </Border>

            <!-- ==================== 登录与恢复 ====================
                 Passkey、应急包、受信设备解决的是同一件事：主密码不可用时怎么回来。
                 所以放在同一张卡里，按"凭据 → 恢复材料 → 本机份额"分组；
                 每种能力先给一句状态，操作放在对应行下面，避免一页文字墙。 -->
            <Border Classes="card">
                <StackPanel Spacing="16">
                    <Grid ColumnDefinitions="Auto,*" ColumnSpacing="12">
                        <Border Classes="securityheroicon">
                            <Path Classes="icon" Data="{x:Static root:Icons.Shield}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="登录与恢复" Classes="h2" />
                            <TextBlock Text="主密码始终可用；也可以使用系统验证、离线扫码可信设备或恢复口令。"
                                       Classes="muted" />
                        </StackPanel>
                    </Grid>

                    <Border Classes="separator" Margin="0" />

                    <!-- 主密码 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="securityicon">
                            <Path Classes="icon" Data="{x:Static root:Icons.Lock}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="主密码" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="最可靠的登录方式；恢复后会自动换成新密码。"
                                       Classes="muted" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="status ok">
                            <TextBlock Text="已设置" />
                        </Border>
                    </Grid>

                    <Border Classes="separator" Margin="44,0,0,0" />

                    <!-- Passkey -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="securityicon">
                            <Path Classes="icon" Data="{x:Static root:Icons.Key}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="Passkey" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="{Binding BioShortHint}" Classes="muted" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="status ok" IsVisible="{Binding BioConfigured}">
                            <TextBlock Text="已启用" />
                        </Border>
                        <Border Grid.Column="2" Classes="status warn" IsVisible="{Binding BioCanConfigure}">
                            <TextBlock Text="未启用" />
                        </Border>
                        <Border Grid.Column="2" Classes="status" IsVisible="{Binding !BioAvailable}">
                            <TextBlock Text="不可用" />
                        </Border>
                    </Grid>

                    <StackPanel Spacing="8" Margin="44,0,0,0">
                        <Grid ColumnDefinitions="*,*" ColumnSpacing="8" IsVisible="{Binding BioAvailable}">
                            <Button Classes="secondary" Content="{Binding PasskeyActionText}"
                                    Command="{Binding BeginSaveBioCommand}"
                                    IsEnabled="{Binding !IsBusy}" />
                            <Button Grid.Column="1" Classes="secondary" Content="测试验证"
                                    Command="{Binding TestBioCommand}"
                                    IsEnabled="{Binding !BioBusy}" />
                        </Grid>

                        <CheckBox Content="打开应用时自动弹出验证" IsChecked="{Binding BioAutoPrompt}"
                                  IsVisible="{Binding BioAvailable}" FontSize="12" />

                        <!-- 保存面板：先校验当前主密码，再把保险库密钥交给系统验证。 -->
                        <Border Classes="inset" IsVisible="{Binding IsSavingBio}">
                            <StackPanel Spacing="9">
                                <TextBlock Text="输入当前主密码" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="验证通过后，系统会保护这把 Passkey 的保险库密钥。"
                                           Classes="muted" />
                                <TextBox Classes="field" Text="{Binding BioPassword}" PasswordChar="●"
                                         PlaceholderText="主密码" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Classes="primary" Content="确认保存"
                                            Command="{Binding ConfirmSaveBioCommand}"
                                            IsEnabled="{Binding !IsBusy}" />
                                    <Button Grid.Column="1" Classes="secondary" Content="取消"
                                            Command="{Binding CancelSaveBioCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Button Classes="danger" Content="清除 Passkey"
                                Command="{Binding ClearBioCommand}"
                                IsVisible="{Binding BioConfigured}"
                                HorizontalAlignment="Left" />

                        <TextBlock Text="{Binding BioMessage}" Classes="muted"
                                   IsVisible="{Binding BioMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                        <TextBlock Text="{Binding BioError}" Classes="error"
                                   IsVisible="{Binding BioError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>

                    <Border Classes="separator" Margin="44,0,0,0" />

                    <!-- 恢复口令：主路径。用户只记一句话，磁盘保存的是 AEAD 密文。 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="securityicon">
                            <Path Classes="icon" Data="{x:Static root:Icons.Key}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="恢复口令" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="输入一段至少 12 个字符的口令；Tama 只保存加密后的密文。"
                                       Classes="muted" />
                            <TextBlock Text="{Binding RecoveryPassphraseStatusLine}" Classes="muted"
                                       FontSize="11.5" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="status ok"
                                IsVisible="{Binding HasRecoveryPassphrase}">
                            <TextBlock Text="已设置" />
                        </Border>
                        <Border Grid.Column="2" Classes="status warn"
                                IsVisible="{Binding !HasRecoveryPassphrase}">
                            <TextBlock Text="未设置" />
                        </Border>
                    </Grid>

                    <StackPanel Spacing="9" Margin="44,0,0,0">
                        <Button Classes="primary" Content="{Binding RecoveryPassphraseActionText}"
                                Command="{Binding BeginSetRecoveryPassphraseCommand}"
                                IsEnabled="{Binding !IsRecoveryBusy}"
                                HorizontalAlignment="Stretch" />

                        <Border Classes="inset" IsVisible="{Binding IsEditingRecoveryPassphrase}">
                            <StackPanel Spacing="9">
                                <TextBlock Text="设置恢复口令" FontWeight="SemiBold" FontSize="13" />
                                <TextBlock Text="口令在输入框中明文显示，但不会上传，也不会以明文写盘。忘记后无法找回，只能重新设置。"
                                           Classes="muted" />
                                <TextBox Classes="field" Text="{Binding RecoveryPassphrase}"
                                         AcceptsReturn="True"
                                         TextWrapping="Wrap"
                                         VerticalContentAlignment="Top"
                                         MinHeight="96"
                                         MaxHeight="180"
                                         MaxLength="1024"
                                         PlaceholderText="输入恢复口令（至少 12 个字符）；可以换行，换行和空格都会参与加密" />
                                <TextBlock Text="{Binding RecoveryPassphraseError}" Classes="error"
                                           IsVisible="{Binding RecoveryPassphraseError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Classes="primary" Content="加密并保存"
                                            Command="{Binding SaveRecoveryPassphraseCommand}"
                                            IsEnabled="{Binding !IsRecoveryBusy}"
                                            HorizontalAlignment="Stretch" />
                                    <Button Grid.Column="1" Classes="secondary" Content="取消"
                                            Command="{Binding CancelSetRecoveryPassphraseCommand}"
                                            HorizontalAlignment="Stretch" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding RecoveryPassphraseMessage}" Classes="muted"
                                   IsVisible="{Binding RecoveryPassphraseMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                        <Button Classes="danger" Content="移除恢复口令"
                                Command="{Binding ClearRecoveryPassphraseCommand}"
                                IsVisible="{Binding HasRecoveryPassphrase}"
                                HorizontalAlignment="Left" />
                    </StackPanel>

                    <Border Classes="separator" Margin="44,0,0,0" />

                    <!-- 旧的三文件份额方案仍可用，但它是例外路径，不再和主要恢复方式抢位置。 -->
                    <Expander Header="高级：离线份额文件" IsExpanded="False"
                              Margin="44,0,0,0" HorizontalAlignment="Stretch">
                        <StackPanel Spacing="12" Margin="0,10,0,0">
                            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                                <Border Classes="securityicon">
                                    <Path Classes="icon" Data="{x:Static root:Icons.Vault}" />
                                </Border>
                                <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                                    <TextBlock Text="离线恢复份额（旧方案）" FontWeight="SemiBold" FontSize="14" />
                                    <TextBlock Text="任意两份文件可恢复；单独一份无法解锁。"
                                               Classes="muted" />
                                    <TextBlock Text="{Binding RecoveryStatusLine}" Classes="muted"
                                               FontSize="11.5" />
                                </StackPanel>
                                <Border Grid.Column="2" Classes="status ok" IsVisible="{Binding HasRecovery}">
                                    <TextBlock Text="已设置" />
                                </Border>
                                <Border Grid.Column="2" Classes="status warn" IsVisible="{Binding !HasRecovery}">
                                    <TextBlock Text="未设置" />
                                </Border>
                            </Grid>

                            <StackPanel Spacing="9">
                                <Button Classes="secondary" Content="{Binding RecoveryActionText}"
                                        Command="{Binding StartRecoveryKitCommand}"
                                        IsEnabled="{Binding CanStartRecoveryKit}"
                                        HorizontalAlignment="Stretch" />
                                <TextBlock Text="把三份文件放到三个不同地点；全部保存成功前，旧应急包仍然有效。"
                                           Classes="muted" />

                                <Border Classes="inset" IsVisible="{Binding HasPendingRecoveryKit}">
                                    <StackPanel Spacing="10">
                                        <Grid ColumnDefinitions="*,Auto">
                                            <TextBlock Text="保存三份应急份额" FontWeight="SemiBold" />
                                            <TextBlock Grid.Column="1" Text="{Binding RecoveryProgressText}"
                                                       Classes="muted" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="3"
                                                     Value="{Binding RecoverySavedCount}"
                                                     Height="4" />

                                        <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8">
                                            <Border Classes="stepbadge" Width="24" Height="24" CornerRadius="12">
                                                <TextBlock Text="1" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="份额 1" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding RecoveryShare1State}" Classes="muted"
                                                           FontSize="11.5" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="secondary" Content="保存文件"
                                                    Command="{Binding SaveRecoveryShareCommand}"
                                                    CommandParameter="0"
                                                    IsEnabled="{Binding !IsRecoveryBusy}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8">
                                            <Border Classes="stepbadge" Width="24" Height="24" CornerRadius="12">
                                                <TextBlock Text="2" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="份额 2" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding RecoveryShare2State}" Classes="muted"
                                                           FontSize="11.5" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="secondary" Content="保存文件"
                                                    Command="{Binding SaveRecoveryShareCommand}"
                                                    CommandParameter="1"
                                                    IsEnabled="{Binding !IsRecoveryBusy}" />
                                        </Grid>

                                        <Grid ColumnDefinitions="26,*,Auto" ColumnSpacing="8">
                                            <Border Classes="stepbadge" Width="24" Height="24" CornerRadius="12">
                                                <TextBlock Text="3" FontSize="11" FontWeight="Bold" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center">
                                                <TextBlock Text="份额 3" FontWeight="SemiBold" FontSize="13" />
                                                <TextBlock Text="{Binding RecoveryShare3State}" Classes="muted"
                                                           FontSize="11.5" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="secondary" Content="保存文件"
                                                    Command="{Binding SaveRecoveryShareCommand}"
                                                    CommandParameter="2"
                                                    IsEnabled="{Binding !IsRecoveryBusy}" />
                                        </Grid>

                                        <Button Classes="ghost" Content="取消生成"
                                                Command="{Binding CancelRecoveryKitCommand}"
                                                HorizontalAlignment="Left" />
                                    </StackPanel>
                                </Border>

                                <TextBlock Text="{Binding RecoveryMessage}" Classes="muted"
                                           IsVisible="{Binding RecoveryMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                                <TextBlock Text="{Binding RecoveryError}" Classes="error"
                                           IsVisible="{Binding RecoveryError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                            </StackPanel>
                        </StackPanel>
                    </Expander>

                    <Border Classes="separator" Margin="44,0,0,0" />

                    <!-- 可信设备：直接管理关系，不再用几段状态文案代替设备列表。 -->
                    <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="12">
                        <Border Classes="securityicon">
                            <Path Classes="icon" Data="{x:Static root:Icons.User}" />
                        </Border>
                        <StackPanel Grid.Column="1" Spacing="3" VerticalAlignment="Center">
                            <TextBlock Text="可信设备" FontWeight="SemiBold" FontSize="14" />
                            <TextBlock Text="解锁时可用已配对手机扫码批准" Classes="muted" />
                        </StackPanel>
                        <Border Grid.Column="2" Classes="status ok"
                                IsVisible="{Binding HasPairedDevices}">
                            <TextBlock Text="{Binding PairedDeviceCountText}" />
                        </Border>
                        <Border Grid.Column="2" Classes="status warn"
                                IsVisible="{Binding !HasPairedDevices}">
                            <TextBlock Text="未配对" />
                        </Border>
                    </Grid>

                    <StackPanel Spacing="8" Margin="44,0,0,0">
                        <TextBlock Text="尚未配对设备" Classes="muted"
                                   IsVisible="{Binding !HasPairedDevices}" />

                        <ItemsControl ItemsSource="{Binding PairedDevices}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:PairedDeviceRow">
                                    <Border Classes="inset" Margin="0,0,0,6">
                                        <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10">
                                            <Border Classes="authoptionicon">
                                                <Path Classes="icon strong" Data="{x:Static root:Icons.User}"
                                                      Width="17" Height="17" />
                                            </Border>
                                            <StackPanel Grid.Column="1" Spacing="2"
                                                        VerticalAlignment="Center">
                                                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                                                <TextBlock Text="{Binding Detail}" Classes="muted" />
                                                <TextBlock Text="{Binding PairedAtText}" Classes="muted"
                                                           FontSize="11" />
                                            </StackPanel>
                                            <Button Grid.Column="2" Classes="ghost danger"
                                                    Content="移除"
                                                    Command="{Binding RemoveCommand}"
                                                    VerticalAlignment="Center" />
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <Button Classes="primary" Content="扫码配对"
                                Command="{Binding BeginTrustedDevicePairingCommand}"
                                IsEnabled="{Binding !IsRecoveryBusy}"
                                HorizontalAlignment="Stretch" />

                        <Border Classes="inset" IsVisible="{Binding IsEditingTrustedDevicePairing}">
                            <StackPanel Spacing="12">
                                <StackPanel Spacing="12" IsVisible="{Binding ShowTrustedDeviceQr}">
                                    <TextBlock Text="用手机系统相机扫描" FontWeight="SemiBold" />
                                    <Border Background="White" CornerRadius="12" Padding="10"
                                            HorizontalAlignment="Center">
                                        <Image Source="{Binding TrustedDeviceQr}"
                                               Width="220" Height="220"
                                               Stretch="Uniform" />
                                    </Border>
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="手机配对码" Classes="label" />
                                    <TextBox Classes="field" Text="{Binding TrustedDevicePairingCode}"
                                             IsReadOnly="True" FontFamily="Consolas,monospace"
                                             HorizontalContentAlignment="Center" />
                                </StackPanel>

                                <StackPanel Spacing="6">
                                    <TextBlock Text="手机显示的 6 位确认码" Classes="label" />
                                    <TextBox x:Name="TrustedDeviceMutualCodeField"
                                             Classes="field"
                                             Text="{Binding TrustedDeviceMutualCodeInput}"
                                             MaxLength="6"
                                             FontFamily="Consolas,monospace"
                                             HorizontalContentAlignment="Center"
                                             PlaceholderText="000000"
                                             GotFocus="OnCodeFieldGotFocus"
                                             LostFocus="OnCodeFieldLostFocus" />
                                </StackPanel>

                                <TextBlock Text="{Binding TrustedDevicePairingError}" Classes="error"
                                           IsVisible="{Binding TrustedDevicePairingError, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />

                                <Grid ColumnDefinitions="*,*" ColumnSpacing="8">
                                    <Button Classes="primary" Content="确认"
                                            Command="{Binding CommitTrustedDevicePairingCommand}"
                                            IsEnabled="{Binding CanCommitTrustedDevicePairing}" />
                                    <Button Grid.Column="1" Classes="secondary" Content="取消"
                                            Command="{Binding CancelTrustedDevicePairingCommand}" />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <TextBlock Text="{Binding TrustedDevicePairingMessage}" Classes="muted"
                                   IsVisible="{Binding TrustedDevicePairingMessage, Converter={x:Static conv:StringConverters.IsNotNullOrEmpty}}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- 外观 -->
            <Border Classes="card">
                <StackPanel Spacing="10">
                    <TextBlock Text="外观" Classes="h2" />
                    <!-- 三选一 = 分段控件：同一条底色里并排，选中项提亮（而不是三个各自带框的芯片） -->
                    <Border Classes="inset" Padding="3" HorizontalAlignment="Left">
                        <StackPanel Orientation="Horizontal" Spacing="2">
                            <Button Classes="chip" Classes.on="{Binding IsSystemTheme}" Content="跟随系统" Command="{Binding UseSystemThemeCommand}" />
                            <Button Classes="chip" Classes.on="{Binding IsDarkTheme}" Content="深色" Command="{Binding UseDarkThemeCommand}" />
                            <Button Classes="chip" Classes.on="{Binding IsLightTheme}" Content="浅色" Command="{Binding UseLightThemeCommand}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

            <!-- 系统时间 -->
            <Border Classes="card">
                <StackPanel Spacing="8">
                    <TextBlock Text="系统时间" Classes="h2" />
                    <TextBlock Text="{Binding ClockStatus}" />
                    <TextBlock Text="{Binding ClockSource}" Classes="muted" />
                    <TextBlock Text="验证码按网络时间计算；本机钟偏了会被网站拒。"
                               Classes="muted" />
                    <Button Classes="secondary" Content="重新检测" HorizontalAlignment="Left"
                            Command="{Binding RecheckClockCommand}" IsEnabled="{Binding !IsBusy}" />
                </StackPanel>
            </Border>

            <!-- 运行信息 -->
            <Border Classes="card">
                <StackPanel Spacing="6">
                    <TextBlock Text="运行信息" Classes="h2" />
                    <TextBlock Text="{Binding GcLabel}" />
                    <TextBlock Text="{Binding Version, StringFormat='版本 {0}'}" Classes="muted" />
                    <TextBlock Text="由发布方式决定（PublishWithSatoriGC），这里读到的是实际生效的那个。"
                               Classes="muted" />
                </StackPanel>
            </Border>

            <Button Classes="danger" Content="立即锁定" HorizontalAlignment="Left" Command="{Binding LockCommand}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
