<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:views="using:Tama.Avalonia.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.VaultView"
             x:DataType="vm:VaultViewModel">

    <Grid>

        <!-- ==================== 桌面：列表 340 + 详情 ==================== -->
        <Grid ColumnDefinitions="340,*" ColumnSpacing="12" Margin="16,8,16,12"
              IsVisible="{Binding !IsCompact}">

            <views:VaultListView Grid.Column="0" />

            <Grid Grid.Column="1">
                <TextBlock Text="从左边选一条，或新建一条。"
                           Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasSelection}" />
                <ContentControl Content="{Binding Selected}" IsVisible="{Binding HasSelection}" />
            </Grid>
        </Grid>

        <!-- ==================== 窄屏：列表 ↔ 详情 两屏切换 ==================== -->
        <Grid Margin="10,4,10,8" IsVisible="{Binding IsCompact}">

            <views:VaultListView IsVisible="{Binding ShowList}" />

            <Grid RowDefinitions="Auto,*" IsVisible="{Binding ShowDetail}">
                <Button Classes="ghost" Content="← 返回列表"
                        HorizontalAlignment="Left" Margin="0,0,0,6"
                        Command="{Binding CloseDetailCommand}" />
                <ContentControl Grid.Row="1" Content="{Binding Selected}" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
