<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:views="using:Tama.Avalonia.Views"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.VaultView"
             x:DataType="vm:VaultViewModel">

    <Grid>

        <!-- ==================== 桌面：列表 340 + 详情 ==================== -->
        <!-- 列表 420：行右侧要放"文件夹 + 同步状态 + 收藏"三个标签，340 会挤 -->
        <Grid ColumnDefinitions="420,*" ColumnSpacing="12" Margin="16,8,16,12"
              IsVisible="{Binding !IsCompact}">

            <views:VaultListView Grid.Column="0" />

            <Grid Grid.Column="1">
                <TextBlock Text="从左边选一条，或新建一条。"
                           Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding !HasSelection}" />
                <ContentControl Content="{Binding Selected}" IsVisible="{Binding HasSelection}" />
            </Grid>
        </Grid>

        <!-- ==================== 窄屏：只有列表，详情就地展开 ====================
             原 Blazor 版就是点一行在行下展开（手风琴），比"切到第二个屏幕"少一次上下文丢失，
             收起时列表还停在原位。 -->
        <Grid Margin="10,2,10,6" IsVisible="{Binding IsCompact}">
            <views:VaultListView />
        </Grid>
    </Grid>
</UserControl>
