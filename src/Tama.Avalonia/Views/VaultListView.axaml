<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:root="using:Tama.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.VaultListView"
             x:DataType="vm:VaultViewModel">

    <!--
      保险库的"左半边"：搜索 + 分面筛选 + 列表。
      抽成独立 UserControl 是**为了响应式**：桌面把它放进 340 宽的分栏，窄屏把它当整屏用。
      如果留在 VaultView 里靠 ColumnDefinitions 切换，就得绑定 ColumnDefinitions —— 那是集合属性，
      编译绑定设不了（AVLN3000）。
    -->
    <!-- 不再套一层"卡片框"：整块列表直接铺在页面底色上（行是最小的视觉单元）。
         之前四周的圆角边框会把列表挤成一个盒子，桌面和手机都显得闷。 -->
    <Border Padding="14,10">
        <DockPanel>

            <StackPanel DockPanel.Dock="Top" Spacing="10">

                <Grid ColumnDefinitions="*,Auto">
                    <!-- 窄屏顶栏已经显示页名了，这里再写一遍"保险库"就是重复 -->
                    <TextBlock Text="保险库" Classes="h1" VerticalAlignment="Center"
                               IsVisible="{Binding !IsCompact}" />
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                        <Button Classes="ghost" Content="新建登录" Command="{Binding NewLoginCommand}" FontSize="12" Padding="10,6" />
                        <Button Classes="ghost" Content="笔记" Command="{Binding NewNoteCommand}" FontSize="12" Padding="10,6" />
                    </StackPanel>
                </Grid>

                <TextBox Classes="field" Text="{Binding SearchText}"
                         PlaceholderText="搜索名称 / 用户名 / 网址 / 备注" />

                <!-- 类型分面 -->
                <ItemsControl ItemsSource="{Binding TypeChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacetChip">
                            <Button Classes="chip" Classes.on="{Binding IsSelected}"
                                    Content="{Binding Display}"
                                    Command="{Binding ToggleCommand}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Margin="0,0,6,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 文件夹分面 -->
                <ItemsControl ItemsSource="{Binding FolderChips}" IsVisible="{Binding HasFolderChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacetChip">
                            <Button Classes="chip" Classes.on="{Binding IsSelected}"
                                    Content="{Binding Display}"
                                    Command="{Binding ToggleCommand}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Margin="0,0,6,6" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel>
                    <Button Classes="chip" Classes.on="{Binding IsTotpFilterOn}" Content="有验证码"
                            Command="{Binding ToggleTotpCommand}" Margin="0,0,6,6" />
                    <Button Classes="chip" Classes.on="{Binding IsPasskeyFilterOn}" Content="有通行密钥"
                            Command="{Binding TogglePasskeyCommand}" Margin="0,0,6,6" />
                    <Button Classes="chip" Content="管理文件夹"
                            Command="{Binding ManageFoldersCommand}" Margin="0,0,6,6" />
                    <Button Classes="chip" Content="清除筛选" IsVisible="{Binding HasFilters}"
                            Command="{Binding ClearFiltersCommand}" Margin="0,0,6,6" />
                </WrapPanel>
            </StackPanel>

            <StackPanel DockPanel.Dock="Bottom" Spacing="6" Margin="0,8,0,0">
                <TextBlock Text="{Binding Error}" Classes="error"
                           IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <!-- 导入/导出只在设置页（屏幕小的时候，列表底部这一行要留给计数，不摆操作按钮） -->
                <TextBlock Text="{Binding Summary}" Classes="muted" />
            </StackPanel>

            <Grid>
                <TextBlock Text="还没有条目。点「新建登录」开始。"
                           Classes="muted" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsEmpty}" />
                <ListBox Classes="tama"
                         ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         IsVisible="{Binding !IsEmpty}">
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CipherRow">
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="8,6">

                                <!-- 行首类型图标：一眼分清登录 / 笔记 / 卡片 / 身份 -->
                                <Border Width="30" Height="30" CornerRadius="15"
                                        Background="{DynamicResource TamaSurfaceBrush}"
                                        BorderBrush="{DynamicResource TamaBorderBrush}"
                                        BorderThickness="1" VerticalAlignment="Center">
                                    <Path Classes="icon" Data="{Binding Icon}" Width="15" Height="15"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>

                                <StackPanel Grid.Column="1" Margin="10,0,8,0" Spacing="2"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <TextBlock Text="{Binding Username}" Classes="muted"
                                               TextTrimming="CharacterEllipsis"
                                               IsVisible="{Binding Username, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="TOTP" Classes="muted" IsVisible="{Binding HasTotp}" />
                                    <TextBlock Text="★" FontSize="12" VerticalAlignment="Center"
                                               Foreground="{DynamicResource TamaWarnBrush}"
                                               IsVisible="{Binding Favorite}" />

                                    <!-- 一行里把"在哪、同步没"这两个状态说完，不用点进去看 -->
                                    <Border Classes="tag" Background="{DynamicResource TamaAccentSoftBrush}"
                                            IsVisible="{Binding HasFolder}">
                                        <TextBlock Text="{Binding FolderName}" FontSize="11" />
                                    </Border>
                                    <Border Classes="tag" Background="{DynamicResource TamaOkSoftBrush}"
                                            IsVisible="{Binding IsSynced}">
                                        <TextBlock Text="已同步" FontSize="11"
                                                   Foreground="{DynamicResource TamaOkBrush}" />
                                    </Border>
                                    <Border Classes="tag" Background="{DynamicResource TamaWarnSoftBrush}"
                                            IsVisible="{Binding IsPending}">
                                        <TextBlock Text="待同步" FontSize="11"
                                                   Foreground="{DynamicResource TamaWarnBrush}" />
                                    </Border>

                                    <Path Classes="icon" Data="{x:Static root:Icons.Chevron}"
                                          Width="12" Height="12" Opacity="0.45" Margin="2,0,0,0" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </DockPanel>
    </Border>
</UserControl>
