<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:root="using:Tama.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             xmlns:cv="using:Tama.Avalonia.Converters"
             xmlns:controls="using:Tama.Avalonia.Views.Controls"
             x:Class="Tama.Avalonia.Views.VaultListView"
             x:DataType="vm:VaultViewModel">

    <UserControl.Resources>
        <!-- 顶部浮层高度 → 列表 top padding（高度是运行期测的：筛选 chip 会换行） -->
        <cv:TopInsetConverter x:Key="TopInset" />
        <cv:MobileListInsetConverter x:Key="MobileInset" />
    </UserControl.Resources>

    <!--
      保险库的"左半边"：搜索 + 分面筛选 + 列表。
      抽成独立 UserControl 是**为了响应式**：桌面把它放进 340 宽的分栏，窄屏把它当整屏用。
      如果留在 VaultView 里靠 ColumnDefinitions 切换，就得绑定 ColumnDefinitions —— 那是集合属性，
      编译绑定设不了（AVLN3000）。
    -->
    <!-- 不再套一层"卡片框"：整块列表直接铺在页面底色上（行是最小的视觉单元）。
         之前四周的圆角边框会把列表挤成一个盒子，桌面和手机都显得闷。 -->
    <Border>
        <Panel>

            <!-- 顶部浮层（工具栏）：标题 + 搜索 + 筛选。
                 内容从它**底下**滚过去，而不是被它推开——Apple 的工具栏是浮在内容上的。 -->
            <StackPanel VerticalAlignment="Top" ZIndex="10">
                <Border x:Name="Header" Background="{DynamicResource TamaHeaderBrush}">
                    <StackPanel Spacing="7" Margin="14,10,14,8">

                <Grid ColumnDefinitions="*,Auto">
                    <!-- 窄屏顶栏已经显示页名了，这里再写一遍"保险库"就是重复 -->
                    <TextBlock Text="保险库" Classes="h1" VerticalAlignment="Center" />
                    <!-- 三个动作都是图标：这一行要放标题，一个词条的宽度换不来多少信息量。
                         ToolTip / 无障碍名保留完整说法（桌面端看得到）。 -->
                    <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="2">
                        <Button Classes="ghost" Command="{Binding ManageFoldersCommand}" Padding="9,6"
                                ToolTip.Tip="管理文件夹" AutomationProperties.Name="管理文件夹">
                            <Path Classes="icon" Data="{x:Static root:Icons.Folder}" Width="15" Height="15" />
                        </Button>
                        <Button Classes="ghost" Command="{Binding NewNoteCommand}" Padding="9,6"
                                ToolTip.Tip="新建笔记" AutomationProperties.Name="新建笔记">
                            <Path Classes="icon" Data="{x:Static root:Icons.Note}" Width="15" Height="15" />
                        </Button>
                        <Button Classes="ghost" Command="{Binding NewLoginCommand}" Padding="9,6"
                                ToolTip.Tip="新建登录" AutomationProperties.Name="新建登录">
                            <Path Classes="icon" Data="{x:Static root:Icons.Plus}" Width="15" Height="15" />
                        </Button>
                    </StackPanel>
                </Grid>

                <TextBox Classes="field" Text="{Binding SearchText}"
                         PlaceholderText="搜索名称 / 用户名 / 网址 / 备注" />

                <!-- 类型分面 -->
                <ItemsControl ItemsSource="{Binding TypeChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacetChip">
                            <Button Classes="chip" Classes.on="{Binding IsSelected}"
                                    Content="{Binding Display}"
                                    Command="{Binding ToggleCommand}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Margin="0,0,6,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- 文件夹分面 -->
                <ItemsControl ItemsSource="{Binding FolderChips}" IsVisible="{Binding HasFolderChips}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FacetChip">
                            <Button Classes="chip" Classes.on="{Binding IsSelected}"
                                    Content="{Binding Display}"
                                    Command="{Binding ToggleCommand}"
                                    IsEnabled="{Binding IsEnabled}"
                                    Margin="0,0,6,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <WrapPanel>
                    <Button Classes="chip" Classes.on="{Binding IsTotpFilterOn}" Content="有验证码"
                            Command="{Binding ToggleTotpCommand}" Margin="0,0,6,3" />
                    <Button Classes="chip" Classes.on="{Binding IsPasskeyFilterOn}" Content="有通行密钥"
                            Command="{Binding TogglePasskeyCommand}" Margin="0,0,6,3" />
                    <Button Classes="chip" Content="清除筛选" IsVisible="{Binding HasFilters}"
                            Command="{Binding ClearFiltersCommand}" Margin="0,0,6,3" />
                </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- 代替一条硬分割线：颜色从"浮层底色"渐隐到透明，
                     内容滚到这里会自然淡出（Apple: scroll edge effect, not a hard divider） -->
                <Border Height="14" Background="{DynamicResource TamaHeaderFadeBrush}" />
            </StackPanel>

            <StackPanel VerticalAlignment="Bottom" ZIndex="6" Spacing="6" Margin="14,0,14,6">
                <TextBlock Text="{Binding Error}" Classes="error"
                           IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                <!-- "共 N 条"只在桌面显示：手机上它是列表底部的一整行，等于白占一条行高，
                     而条数本身对手机用户没什么用（他关心的是列表本身）。
                     导入/导出入口只在设置页，这里不摆操作按钮。 -->
                <TextBlock Text="{Binding Summary}" Classes="muted" IsVisible="{Binding !IsCompact}" />
            </StackPanel>

            <Grid Margin="14,0,14,26">
                <TextBlock Text="还没有条目。点右上角的 + 开始。"
                           Classes="muted" TextAlignment="Center"
                           HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsVisible="{Binding IsEmpty}" />
                <ListBox Classes="tama" ItemsSource="{Binding Rows}"
                         SelectedItem="{Binding SelectedRow}"
                         IsVisible="{Binding !IsEmpty}">
                    <ListBox.Padding>
                        <MultiBinding Converter="{StaticResource MobileInset}">
                            <Binding Path="#Header.Bounds.Height" />
                            <Binding Path="IsCompact" FallbackValue="False" />
                        </MultiBinding>
                    </ListBox.Padding>
                    <ListBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:CipherRow">
                          <StackPanel>
                            <!-- 一行只表达三件事：名字（粗）、附属信息（一条灰字）、异常状态（待同步）。
                                 行首图标只留给非登录条目，行尾只留收藏星 + 箭头。 -->
                            <!-- Background="Transparent" 是**必须**的：Avalonia（和 WPF 一样）只命中有背景的区域，
                                 没有它的话行里空白处点不动，实际只有箭头/按钮能点（用户实测"只能点箭头展开"）。 -->
                            <Grid ColumnDefinitions="Auto,*,Auto" Margin="12,0" Background="Transparent">

                                <Path Classes="icon" Data="{Binding Icon}" Width="15" Height="15"
                                      Opacity="0.5" Margin="0,0,10,0" VerticalAlignment="Center"
                                      IsVisible="{Binding ShowTypeIcon}" />

                                <StackPanel Grid.Column="1" Spacing="3" Margin="0,9"
                                            VerticalAlignment="Center">
                                    <TextBlock Text="{Binding Name}" FontSize="14" FontWeight="SemiBold"
                                               TextTrimming="CharacterEllipsis" />
                                    <StackPanel Orientation="Horizontal" Spacing="6"
                                                IsVisible="{Binding HasSecondaryLine}">
                                        <TextBlock Text="{Binding Secondary}" Classes="muted"
                                                   TextTrimming="CharacterEllipsis"
                                                   IsVisible="{Binding HasSecondary}" />
                                        <!-- "已同步"是默认状态，不画；只有待同步值得占位置。
                                             放在第二行而不是行尾：行尾要留给验证码 -->
                                        <TextBlock Text="待同步" FontSize="11" VerticalAlignment="Center"
                                                   Foreground="{DynamicResource TamaWarnBrush}"
                                                   IsVisible="{Binding IsPending}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="8"
                                            VerticalAlignment="Center">
                                    <!-- 有 TOTP 就**直接把码摆在行尾** + 一个剩余时间小圆环：
                                         验证码是每天要用很多次的东西，不该逼人点进详情再看 -->
                                    <!-- 点码即复制（连圆环一起做成按钮，扩大可点区域） -->
                                    <Button Classes="totp" IsVisible="{Binding HasTotp}"
                                            ToolTip.Tip="点击复制验证码"
                                            AutomationProperties.Name="复制验证码"
                                            Command="{Binding $parent[ListBox].((vm:VaultViewModel)DataContext).CopyRowTotpCommand}"
                                            CommandParameter="{Binding}">
                                        <StackPanel Orientation="Horizontal" Spacing="6">
                                            <TextBlock Text="{Binding TotpCode}" Classes="mono"
                                                       Classes.expiring="{Binding TotpExpiring}" FontSize="13" />
                                            <controls:TotpRing Width="15" Height="15"
                                                               Progress="{Binding TotpProgress}"
                                                               RingBrush="{DynamicResource TamaAccentBrush}"
                                                               TrackBrush="{DynamicResource TamaBorderBrush}" />
                                        </StackPanel>
                                    </Button>

                                    <Path Classes="icon" Data="{x:Static root:Icons.Star}"
                                          Width="12" Height="12"
                                          Fill="{DynamicResource TamaWarnBrush}"
                                          IsVisible="{Binding Favorite}" />

                                    <!-- 展开时的收起入口就是这个箭头本身，不再在底部放一个大按钮 -->
                                    <Button Classes="chevron" IsVisible="{Binding IsExpanded}"
                                            Command="{Binding $parent[ListBox].((vm:VaultViewModel)DataContext).CloseDetailCommand}">
                                        <Path Classes="icon" Data="{x:Static root:Icons.ChevronUp}"
                                              Width="14" Height="14" />
                                    </Button>
                                    <Path Classes="icon" Data="{x:Static root:Icons.Chevron}"
                                          Width="12" Height="12" Opacity="0.35" Margin="2,0,0,0"
                                          IsVisible="{Binding !IsExpanded}" />
                                </StackPanel>
                            </Grid>

                            <!-- 手机：详情就地展开在行下面（原 Blazor 版的交互），
                                 不跳页、不丢当前滚动位置。桌面不会走到这里(Detail 只在紧凑态挂上)。 -->
                            <ContentControl IsVisible="{Binding IsExpanded}" Content="{Binding Detail}"
                                            Margin="14,0,8,8" />
                          </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </Grid>
        </Panel>
    </Border>
</UserControl>
