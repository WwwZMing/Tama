<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.PasskeysView"
             x:DataType="vm:PasskeysViewModel">

    <!-- pagepane：手机上给滚动内容末尾留出底栏的空白（样式见 Styles/Tama.axaml，桌面不受影响） -->
    <ScrollViewer>
        <StackPanel Classes="pagepane" Spacing="14">

            <StackPanel Spacing="2">
                <TextBlock Text="通行密钥" Classes="h1" />
                <TextBlock Text="通行密钥由网站发起创建；这里管理已存在的凭据" Classes="muted" />
            </StackPanel>

            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

            <TextBlock Text="当前平台不支持通行密钥（Windows Hello / Android 凭据管理器不可用）。"
                       Classes="muted" IsVisible="{Binding !IsAvailable}" />

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button Classes="ghost" Content="启用云端已同步的凭据" Command="{Binding AdoptAllCommand}" />
                <Button Classes="ghost" Content="从 Bitwarden JSON 导入" Command="{Binding ImportJsonCommand}" />
                <Button Classes="chip" Content="刷新" Command="{Binding RefreshCommand}" />
            </StackPanel>

            <TextBlock Text="还没有通行密钥。" Classes="muted" IsVisible="{Binding IsEmpty}" />

            <ItemsControl ItemsSource="{Binding Entries}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:PasskeyRow">
                        <Border Classes="card" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Text="{Binding RpId}" FontWeight="SemiBold" />
                                        <Border Background="{DynamicResource TamaAccentSoftBrush}" CornerRadius="6" Padding="6,2">
                                            <TextBlock Text="{Binding SourceText}" FontSize="11" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding Detail}" Classes="muted" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Classes="primary" Content="启用" Command="{Binding AdoptCommand}"
                                            IsVisible="{Binding IsCloudOnly}" />
                                    <Button Classes="danger" Content="删除" Command="{Binding DeleteCommand}"
                                            IsVisible="{Binding IsLocal}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</UserControl>
