<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:views="using:Tama.Avalonia.Views"
             xmlns:controls="using:Tama.Avalonia.Views.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <Grid Background="{DynamicResource TamaBgBrush}">

        <!-- ==================== 桌面：左侧栏 + 页面 ==================== -->
        <Grid ColumnDefinitions="216,*" IsVisible="{Binding ShowDesktopShell}">

            <Border Grid.Column="0"
                    Background="{DynamicResource TamaSurfaceBrush}"
                    BorderBrush="{DynamicResource TamaBorderBrush}"
                    BorderThickness="0,0,1,0">
                <DockPanel Margin="12,14">

                    <StackPanel DockPanel.Dock="Top" Spacing="18">
                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="6,0,0,4">
                            <controls:BrandMark Width="24" Height="24"
                                                Stroke="{DynamicResource TamaAccentBrush}"
                                                VerticalAlignment="Center" />
                            <TextBlock Text="Tama" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <ItemsControl ItemsSource="{Binding NavItems}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <StackPanel Spacing="2" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavItem">
                                    <Button Classes="nav" Classes.on="{Binding IsActive}"
                                            Content="{Binding Label}" Command="{Binding GoCommand}" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="8">
                        <Button Classes="ghost" Content="锁定" HorizontalAlignment="Stretch"
                                Command="{Binding LockCommand}" />
                        <TextBlock Text="本地优先 · 端到端加密" Classes="muted" HorizontalAlignment="Center" />
                    </StackPanel>

                    <!-- 占位：让 Top/Bottom 两组贴边 -->
                    <Panel />
                </DockPanel>
            </Border>

            <views:PageHost Grid.Column="1" />
        </Grid>

        <!-- ==================== 窄屏（手机 / 窄窗口）：顶栏 + 底部 Tab ==================== -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowMobileShell}">

            <!-- 顶栏。顶部 26px 是给 Android 状态栏留的：Avalonia 的 Android 宿主是
                 全屏布局，不自己留的话内容会顶到状态栏底下（标题被时间/信号图标压住）。 -->
            <Border Grid.Row="0"
                    Background="{DynamicResource TamaSurfaceBrush}"
                    BorderBrush="{DynamicResource TamaBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,26,12,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:BrandMark Width="20" Height="20"
                                        Stroke="{DynamicResource TamaAccentBrush}"
                                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}"
                               Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="chip" Content="锁定" Command="{Binding LockCommand}" />
                </Grid>
            </Border>

            <views:PageHost Grid.Row="1" />

            <!-- 底部 Tab：6 等分。底部 8px 是手势条留白 -->
            <Border Grid.Row="2"
                    Background="{DynamicResource TamaSurfaceBrush}"
                    BorderBrush="{DynamicResource TamaBorderBrush}"
                    BorderThickness="0,1,0,0"
                    Padding="4,4,4,8">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Button Classes="tab" Classes.on="{Binding IsActive}"
                                    Content="{Binding ShortLabel}" Command="{Binding GoCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- === 未解锁：门禁页 ===
             注意包一层 Panel：UnlockView 自己声明了 x:DataType=UnlockViewModel，
             直接写在它身上的 IsVisible 会被编译成对 UnlockViewModel 的绑定（报 AVLN2000）。 -->
        <Panel IsVisible="{Binding !IsUnlocked}">
            <views:UnlockView DataContext="{Binding Unlock}" />
        </Panel>

        <!-- === 浮层：所有对话框都走这里（桌面 / 安卓同一套） === -->
        <Border IsVisible="{Binding OverlayContent, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Background="#AA000000">
            <ContentControl Content="{Binding OverlayContent}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
        </Border>
    </Grid>
</UserControl>
