<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:root="using:Tama.Avalonia"
             xmlns:views="using:Tama.Avalonia.Views"
             xmlns:controls="using:Tama.Avalonia.Views.Controls"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.ShellView"
             x:DataType="vm:ShellViewModel">

    <!-- Classes.mobile 是**触控样式的作用域**：所有"手机上台面要更大"的规则都挂在
         Grid.mobile 下面（见 Styles/Tama.axaml），桌面尺寸一个都不动。 -->
    <Grid Classes="shellroot" Classes.mobile="{Binding ShowMobileShell}">

        <!-- ==================== 桌面：悬浮侧栏 + 全宽内容 ==================== -->
        <Grid IsVisible="{Binding ShowDesktopShell}">

            <!-- 内容铺满整个窗口，只在左边让出侧栏的宽度。侧栏本身是**浮在内容之上**的独立卡片
                 （不是把窗口切成两列）：页面背景一直延伸到窗口左缘，滚动时内容从卡片底下经过。 -->
            <views:PageHost Margin="232,0,0,0" />

            <Border Classes="sidebar" Width="216" Margin="8"
                    HorizontalAlignment="Left" VerticalAlignment="Stretch"
                    CornerRadius="18" BorderThickness="1"
                    BoxShadow="0 10 30 0 #66000000">
                <DockPanel Margin="10,14">

                    <StackPanel DockPanel.Dock="Top" Spacing="16">
                        <StackPanel Orientation="Horizontal" Spacing="9" Margin="6,2,0,2">
                            <controls:BrandMark Width="26" Height="26"
                                                Stroke="{DynamicResource TamaAccentBrush}"
                                                VerticalAlignment="Center" />
                            <TextBlock Text="Tama" FontSize="17" FontWeight="SemiBold" VerticalAlignment="Center" />
                        </StackPanel>

                        <!-- 分组导航：六项平铺会把"我在干什么"这层信息丢掉，
                             所以按 密码库 / 安全 / 账号 切开，标题弱化成小字，靠间距而不是分割线分组。 -->
                        <ItemsControl ItemsSource="{Binding NavGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="vm:NavGroup">
                                    <StackPanel Spacing="2" Margin="0,0,0,12">
                                        <TextBlock Text="{Binding Title}" Classes="navgroup" />
                                        <ItemsControl ItemsSource="{Binding Items}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate x:DataType="vm:NavItem">
                                                    <Button Classes="nav" Classes.on="{Binding IsActive}"
                                                            Command="{Binding GoCommand}">
                                                        <StackPanel Orientation="Horizontal" Spacing="10">
                                                            <Path Classes="icon" Data="{Binding Icon}" />
                                                            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" />
                                                        </StackPanel>
                                                    </Button>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel DockPanel.Dock="Bottom" Spacing="4">
                        <Button Classes="nav" Command="{Binding ToggleThemeCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Classes="icon" Data="{x:Static root:Icons.Moon}" />
                                <TextBlock Text="{Binding ThemeToggleLabel}" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                        <Button Classes="nav" Command="{Binding LockCommand}">
                            <StackPanel Orientation="Horizontal" Spacing="10">
                                <Path Classes="icon" Data="{x:Static root:Icons.Lock}" />
                                <TextBlock Text="锁定" VerticalAlignment="Center" />
                            </StackPanel>
                        </Button>
                    </StackPanel>

                    <!-- 占位：让 Top/Bottom 两组贴边 -->
                    <Panel />
                </DockPanel>
            </Border>
        </Grid>

        <!-- ==================== 窄屏（手机 / 窄窗口）：顶栏 + 底部 Tab ==================== -->
        <Grid RowDefinitions="Auto,*,Auto" IsVisible="{Binding ShowMobileShell}">

            <!-- 顶栏。顶部 26px 是给 Android 状态栏留的：Avalonia 的 Android 宿主是
                 全屏布局，不自己留的话内容会顶到状态栏底下（标题被时间/信号图标压住）。 -->
            <Border Grid.Row="0" Classes="topbar"
                    BorderBrush="{DynamicResource TamaBorderBrush}"
                    BorderThickness="0,0,0,1"
                    Padding="14,26,12,10">
                <Grid ColumnDefinitions="Auto,*,Auto">
                    <controls:BrandMark Width="20" Height="20"
                                        Stroke="{DynamicResource TamaAccentBrush}"
                                        VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding CurrentTitle}"
                               Margin="8,0,0,0" FontSize="15" FontWeight="SemiBold"
                               VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <Button Grid.Column="2" Classes="chip" Content="锁定" Command="{Binding LockCommand}" />
                </Grid>
            </Border>

            <views:PageHost Grid.Row="1" />

            <!-- 底部 Tab：6 等分。做成"浮动条"（圆角 + 抬升阴影）——
                 手机上没有背景模糊 API，"玻璃感"只能靠半透明 + 描边 + 阴影来表达；
                 Windows 上窗口若拿到 Mica，它的底色会真的透出桌面壁纸。 -->
            <Border Grid.Row="2" Classes="bottombar"
                    BorderBrush="{DynamicResource TamaBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="16"
                    Padding="4,6,4,6"
                    Margin="8,0,8,8"
                    BoxShadow="0 4 20 0 #55000000">
                <ItemsControl ItemsSource="{Binding NavItems}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:NavItem">
                            <Button Classes="tab" Classes.on="{Binding IsActive}"
                                    Content="{Binding ShortLabel}" Command="{Binding GoCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Border>
        </Grid>

        <!-- === 未解锁：门禁页 ===
             注意包一层 Panel：UnlockView 自己声明了 x:DataType=UnlockViewModel，
             直接写在它身上的 IsVisible 会被编译成对 UnlockViewModel 的绑定（报 AVLN2000）。 -->
        <Panel IsVisible="{Binding !IsUnlocked}">
            <views:UnlockView DataContext="{Binding Unlock}" />
        </Panel>

        <!-- === 浮层：所有对话框都走这里（桌面 / 安卓同一套） === -->
        <Border IsVisible="{Binding OverlayContent, Converter={x:Static conv:ObjectConverters.IsNotNull}}"
                Background="#AA000000">
            <ContentControl Content="{Binding OverlayContent}"
                            HorizontalAlignment="Center" VerticalAlignment="Center" Margin="24" />
        </Border>
    </Grid>
</UserControl>
