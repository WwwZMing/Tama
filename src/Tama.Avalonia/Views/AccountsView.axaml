<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.AccountsView"
             x:DataType="vm:AccountsViewModel">

    <ScrollViewer>
        <StackPanel Spacing="14" Margin="16,8,16,16">

            <Grid ColumnDefinitions="*,Auto">
                <StackPanel Spacing="2">
                    <TextBlock Text="账号" Classes="h1" />
                    <TextBlock Text="关联 Bitwarden 后可双向同步；本地库始终是唯一真相源" Classes="muted" />
                </StackPanel>
                <Button Grid.Column="1" Classes="primary" Content="添加账号"
                        Command="{Binding ToggleLoginFormCommand}" />
            </Grid>

            <TextBlock Text="{Binding Error}" Classes="error"
                       IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

            <!-- === 登录表单 === -->
            <Border Classes="card" IsVisible="{Binding ShowLoginForm}">
                <StackPanel Spacing="10">
                    <TextBlock Text="Bitwarden 登录" Classes="h2" />

                    <StackPanel Spacing="4" IsVisible="{Binding !IsTwoFactorStep}">
                        <TextBlock Text="邮箱" Classes="muted" />
                        <TextBox Classes="field" Text="{Binding Email}" PlaceholderText="you@example.com" />
                    </StackPanel>

                    <StackPanel Spacing="4">
                        <TextBlock Text="主密码" Classes="muted" />
                        <TextBox Classes="field" Text="{Binding MasterPassword}" PasswordChar="●" />
                    </StackPanel>

                    <StackPanel Spacing="4" IsVisible="{Binding IsTwoFactorStep}">
                        <TextBlock Text="验证码" Classes="muted" />
                        <TextBox Classes="field" Text="{Binding VerificationCode}" PlaceholderText="6 位验证码" />
                        <TextBlock Text="{Binding Info}" Classes="muted" />
                    </StackPanel>

                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <Button Classes="primary" Content="登录" Command="{Binding LoginCommand}"
                                IsEnabled="{Binding !IsBusy}" />
                        <Button Classes="ghost" Content="取消验证" Command="{Binding CancelTwoFactorCommand}"
                                IsVisible="{Binding IsTwoFactorStep}" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- === 账号列表 === -->
            <ItemsControl ItemsSource="{Binding Accounts}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:AccountRow">
                        <Border Classes="card" Padding="14" Margin="0,0,0,8">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="2">
                                    <TextBlock Text="{Binding Email}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding ServerText}" Classes="muted" />
                                    <TextBlock Text="{Binding Status}" Classes="muted" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6"
                                            VerticalAlignment="Center">
                                    <Button Classes="ghost" Content="立即同步" Command="{Binding SyncCommand}" />
                                    <Button Classes="danger" Content="删除" Command="{Binding DeleteCommand}" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <TextBlock Text="还没有关联账号。" Classes="muted" IsVisible="{Binding IsEmpty}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
