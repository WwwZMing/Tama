<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tama.Avalonia.ViewModels"
        xmlns:views="using:Tama.Avalonia.Views"
        x:Class="Tama.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Tama"
        Width="1120" Height="740"
        MinWidth="480" MinHeight="520"
        Background="{DynamicResource TamaBgBrush}"
        Icon="/Assets/appicon.ico">
    <views:ShellView />
</Window>
