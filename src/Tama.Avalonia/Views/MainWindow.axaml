<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Tama.Avalonia.ViewModels"
        xmlns:views="using:Tama.Avalonia.Views"
        x:Class="Tama.Avalonia.Views.MainWindow"
        x:DataType="vm:ShellViewModel"
        Title="Tama"
        Width="1120" Height="740"
        MinWidth="360" MinHeight="480"
        Icon="/Assets/appicon.ico">
    <!-- 用系统标题栏。
         ⚠️ 试过 ExtendClientAreaToDecorationsHint + 自绘按钮，结果和系统 caption 叠在一起
         （用户实测"重叠出现了一个"），已整体回滚。真要做无边框窗口得单独一轮：
         隐藏 caption、拖动区、双击最大化、缩放边框都要一起验，不能只加两个属性了事。
         Background 不在 window 上写，交给 Window / Window.mica 样式。 -->
    <views:ShellView />
</Window>
