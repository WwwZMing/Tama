<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Tama.Avalonia.ViewModels"
             xmlns:root="using:Tama.Avalonia"
             xmlns:conv="using:Avalonia.Data.Converters"
             x:Class="Tama.Avalonia.Views.CipherDetailView"
             x:DataType="vm:CipherDetailViewModel">

    <Border Classes="panel" Padding="18">
        <DockPanel>

            <!-- 头部：标题 + 操作。
                 操作放在**独立一行**而不是和标题抢同一行：手机上是"就地展开"，
                 可用宽度只有 ~330px，标题和三个按钮并排会把标题挤成竖排（实测很难看）。 -->
            <StackPanel DockPanel.Dock="Top" Spacing="8" Margin="0,0,0,12">
                <StackPanel Spacing="2">
                    <TextBlock Text="{Binding Name}" Classes="h1" TextWrapping="Wrap" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{Binding TypeLabel}" Classes="muted" />
                        <TextBlock Text="已收藏" Classes="muted" IsVisible="{Binding Favorite}" />
                        <TextBlock Text="{Binding SyncHint}" Classes="muted" />
                    </StackPanel>
                </StackPanel>

                <StackPanel Orientation="Horizontal" Spacing="6" HorizontalAlignment="Right">
                    <Button Classes="ghost" Command="{Binding ToggleFavoriteCommand}"
                            IsVisible="{Binding !IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="icon" Data="{x:Static root:Icons.Star}" Width="14" Height="14" />
                        <TextBlock Text="收藏" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                    <Button Classes="ghost" Command="{Binding BeginEditCommand}"
                            IsVisible="{Binding !IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="icon" Data="{x:Static root:Icons.Edit}" Width="14" Height="14" />
                        <TextBlock Text="编辑" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                    <Button Classes="primary" Command="{Binding SaveCommand}"
                            IsVisible="{Binding IsEditing}" IsEnabled="{Binding !IsBusy}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="icon" Data="{x:Static root:Icons.Save}" Width="14" Height="14" />
                        <TextBlock Text="保存" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                    <Button Classes="ghost" Command="{Binding CancelCommand}"
                            IsVisible="{Binding IsEditing}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="icon" Data="{x:Static root:Icons.Close}" Width="14" Height="14" />
                        <TextBlock Text="取消" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                    <Button Classes="danger" Command="{Binding DeleteCommand}"
                            IsVisible="{Binding !IsNew}">
                    <StackPanel Orientation="Horizontal" Spacing="5">
                        <Path Classes="icon" Data="{x:Static root:Icons.Delete}" Width="14" Height="14" />
                        <TextBlock Text="删除" VerticalAlignment="Center" />
                    </StackPanel>
                </Button>
                </StackPanel>
            </StackPanel>

            <TextBlock DockPanel.Dock="Bottom" Text="{Binding Error}" Classes="error" Margin="0,8,0,0"
                       IsVisible="{Binding Error, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />

            <ScrollViewer>
                <StackPanel Spacing="12" Margin="0,0,4,0">

                    <!-- === 只读 === -->
                    <StackPanel Spacing="12" IsVisible="{Binding !IsEditing}">

                        <Border Classes="card" Padding="14" IsVisible="{Binding HasTotp}">
                            <Grid ColumnDefinitions="*,Auto">
                                <StackPanel Spacing="4">
                                    <TextBlock Text="验证码" Classes="muted" />
                                    <TextBlock Text="{Binding TotpDisplay}" FontSize="26" Classes="mono" />
                                    <ProgressBar Value="{Binding TotpSecondsLeft}" Maximum="30" Height="3" />
                                </StackPanel>
                                <Button Grid.Column="1" Classes="ghost copy" VerticalAlignment="Center" Command="{Binding CopyTotpCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Path Classes="icon" Data="{x:Static root:Icons.Copy}" Width="12" Height="12" />
                                        <TextBlock Text="复制" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                        </Border>

                        <Border Classes="card" Padding="14">
                            <StackPanel Spacing="10">
                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLogin}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="用户名" Classes="muted" />
                                        <TextBlock Text="{Binding Username}" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost copy" VerticalAlignment="Center" Command="{Binding CopyUsernameCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Path Classes="icon" Data="{x:Static root:Icons.Copy}" Width="12" Height="12" />
                                        <TextBlock Text="复制" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLogin}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="密码" Classes="muted" />
                                        <TextBlock Text="••••••••" FontSize="15" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost copy" VerticalAlignment="Center" Command="{Binding CopyPasswordCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Path Classes="icon" Data="{x:Static root:Icons.Copy}" Width="12" Height="12" />
                                        <TextBlock Text="复制" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                </Grid>

                                <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsLogin}">
                                    <StackPanel Spacing="2">
                                        <TextBlock Text="网址" Classes="muted" />
                                        <TextBlock Text="{Binding Uri}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                    <Button Grid.Column="1" Classes="ghost copy" VerticalAlignment="Center" Command="{Binding CopyUriCommand}">
                                    <StackPanel Orientation="Horizontal" Spacing="3">
                                        <Path Classes="icon" Data="{x:Static root:Icons.Copy}" Width="12" Height="12" />
                                        <TextBlock Text="复制" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Classes="card" Padding="14" IsVisible="{Binding Notes, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="备注" Classes="muted" />
                                <TextBlock Text="{Binding Notes}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- === 编辑 === -->
                    <StackPanel Spacing="10" IsVisible="{Binding IsEditing}">

                        <StackPanel Spacing="4">
                            <TextBlock Text="名称" Classes="muted" />
                            <TextBox Classes="field" Text="{Binding Name}" PlaceholderText="例如：GitHub" />
                        </StackPanel>

                        <StackPanel Spacing="10" IsVisible="{Binding IsLogin}">
                            <StackPanel Spacing="4">
                                <TextBlock Text="用户名" Classes="muted" />
                                <TextBox Classes="field" Text="{Binding Username}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="密码" Classes="muted" />
                                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                                    <TextBox Classes="field" Text="{Binding Password}" PasswordChar="●" />
                                    <Button Grid.Column="1" Classes="ghost" Content="生成"
                                            Command="{Binding GeneratePasswordCommand}" />
                                </Grid>
                                <TextBlock Text="{Binding StrengthLabel}" Classes="muted" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="TOTP 密钥（otpauth:// 或 Base32）" Classes="muted" />
                                <TextBox Classes="field" Text="{Binding TotpSecret}" />
                            </StackPanel>

                            <StackPanel Spacing="4">
                                <TextBlock Text="网址" Classes="muted" />
                                <TextBox Classes="field" Text="{Binding Uri}" />
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="文件夹" Classes="muted" />
                            <ComboBox ItemsSource="{Binding FolderOptions}"
                                      SelectedItem="{Binding SelectedFolder}"
                                      HorizontalAlignment="Stretch">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate x:DataType="vm:FolderOption">
                                        <TextBlock Text="{Binding Name}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </StackPanel>

                        <StackPanel Spacing="4">
                            <TextBlock Text="备注" Classes="muted" />
                            <TextBox Classes="field" Text="{Binding Notes}"
                                     AcceptsReturn="True" TextWrapping="Wrap" Height="110" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </DockPanel>
    </Border>
</UserControl>
