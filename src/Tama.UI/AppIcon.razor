@* 统一单色图标集：stroke=currentColor，颜色完全由容器 CSS 控制。
    替代 emoji（Windows 永远彩色）与文本字形（永远跟随文字色）混排造成的"花一块灰一块"。 *@
<svg class="@Class" viewBox="0 0 24 24" width="@Size" height="@Size" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    @((MarkupString)Paths)
</svg>

@code {
    /// <summary>图标名：vault / shield / bolt / key / folder / gear / cloud / star / note / card / id / chevron-right / menu</summary>
    [Parameter, EditorRequired] public string Name { get; set; } = "";

    /// <summary>像素尺寸（默认 18，行图标 16~18）</summary>
    [Parameter] public int Size { get; set; } = 18;

    /// <summary>透传 CSS 类（Blazor 对未声明参数会抛异常，不能靠"静默忽略"）</summary>
    [Parameter] public string? Class { get; set; }

    private string Paths => Name switch
    {
        "vault" => "<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/>",
        "shield" => "<path d=\"M12 3l7 3v5c0 4.6-3 7.9-7 10-4-2.1-7-5.4-7-10V6z\"/>",
        "bolt" => "<path d=\"M13 2L4.5 13.5H11L9.5 22L18 10.5h-6.5z\"/>",
        "key" => "<circle cx=\"7.5\" cy=\"15.5\" r=\"3.5\"/><path d=\"M10.2 13.2L20 3.5M16 7.5L19.5 11M13.5 10.5l2 2\"/>",
        "folder" => "<path d=\"M3 7a2 2 0 0 1 2-2h4l2 2h8a2 2 0 0 1 2 2v8a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z\"/>",
        "gear" => "<circle cx=\"12\" cy=\"12\" r=\"3.2\"/><path d=\"M12 2.8v2.7M12 18.5v2.7M2.8 12h2.7M18.5 12h2.7M5.5 5.5l1.9 1.9M16.6 16.6l1.9 1.9M18.5 5.5l-1.9 1.9M7.4 16.6l-1.9 1.9\"/>",
        "cloud" => "<path d=\"M7 18a4 4 0 1 1 .6-7.96A5.5 5.5 0 0 1 18.4 11a3.5 3.5 0 0 1-.9 6.9z\"/>",
        "star" => "<path d=\"M12 3l1.8 5.2L19 10l-5.2 1.8L12 17l-1.8-5.2L5 10l5.2-1.8z\"/>",
        "note" => "<rect x=\"5\" y=\"3.5\" width=\"14\" height=\"17\" rx=\"2\"/><path d=\"M8.5 8.5h7M8.5 12h7M8.5 15.5h4.5\"/>",
        "card" => "<rect x=\"3\" y=\"5.5\" width=\"18\" height=\"13\" rx=\"2\"/><path d=\"M3 10h18M6.5 15h4\"/>",
        "id" => "<rect x=\"3.5\" y=\"5\" width=\"17\" height=\"14\" rx=\"2\"/><circle cx=\"9\" cy=\"11\" r=\"2\"/><path d=\"M6.5 16c.6-1.6 1.6-2.4 2.5-2.4s1.9.8 2.5 2.4M14 9.5h4M14 13h3\"/>",
        "chevron-right" => "<path d=\"M9.5 6.5l5.5 5.5-5.5 5.5\"/>",
        "menu" => "<path d=\"M4 7h16M4 12h16M4 17h16\"/>",
        "clock" => "<circle cx=\"12\" cy=\"12\" r=\"8.5\"/><path d=\"M12 7.2V12l3.2 2\"/>",
        _ => "<rect x=\"5\" y=\"11\" width=\"14\" height=\"9\" rx=\"2\"/><path d=\"M8 11V7a4 4 0 0 1 8 0v4\"/>",
    };
}
