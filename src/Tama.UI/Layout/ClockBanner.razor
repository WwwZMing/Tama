@* 系统时钟偏差提示。
   背景：本机时钟可能被关掉的自动同步/手动改时间带偏（实测慢过 24 小时），而 TOTP 只容忍
   ±1 个 30 秒窗口——验证码会"看起来正常但全被拒绝"。详情面板里的 TOTP 已经按网络时间校正，
   这里负责把"你的系统时钟不准"这件事明确告诉用户，并给一个重新检测的按钮。
   自动每 10 分钟重校一次：用户修好时钟后，横幅会自己消失。 *@
@inject IClockApi Clock
@implements IDisposable

@if (_snapshot is { IsDrifted: true } drift)
{
    <MudAlert Severity="Severity.Warning" Class="tm-clock-banner" Dense="true">
        <div class="tm-clock-row">
            <span>
                系统时钟比网络时间<strong>@(drift.Skew < TimeSpan.Zero ? "慢" : "快") @Describe(drift.Skew)</strong>，
                验证码（TOTP）已按网络时间校正。建议在系统设置里开启「自动设置时间」。
            </span>
            <MudButton Variant="Variant.Text" Size="Size.Small"
                       Disabled="@(_checking == 1)"
                       @onclick="RecheckAsync">@(_checking == 1 ? "检测中…" : "重新检测")</MudButton>
        </div>
    </MudAlert>
}

@code {
    private ClockSyncSnapshot? _snapshot;
    private int _checking;
    private Timer? _timer;
    private bool _disposed;

    protected override void OnInitialized()
    {
        _snapshot = Clock.LastSnapshot;
        // 复制验证码会强制校时一次：横幅要跟着立刻更新，别等 5 分钟定时轮询。
        Clock.Synced += OnClockSynced;
    }

    /// <summary>校时成功回调（后台线程）：只换快照，刷新交给 InvokeAsync。</summary>
    private void OnClockSynced(ClockSyncSnapshot snapshot)
    {
        _snapshot = snapshot;
        if (_disposed) return;
        try { _ = InvokeAsync(StateHasChanged); }
        catch { /* 电路已断开 */ }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        // 周期重校：用户中途修好时钟 / 换了网络之后，提示与校正都能自愈。
        // 间隔与 NetworkClockService 的 5 分钟缓存对齐（更密没有意义：缓存会直接返回）。
        _timer = new Timer(_ => _ = CheckAsync(force: false), null,
            TimeSpan.FromMinutes(5), TimeSpan.FromMinutes(5));
        await CheckAsync(force: false);
    }

    private Task RecheckAsync() => CheckAsync(force: true);

    private async Task CheckAsync(bool force)
    {
        // 定时器线程与按钮可能撞车：抢不到就直接返回，不排队重复联网。
        if (Interlocked.Exchange(ref _checking, 1) == 1) return;
        try
        {
            await InvokeAsync(StateHasChanged);   // 立刻反馈"检测中…"
            _snapshot = await Clock.SyncAsync(force);
        }
        catch
        {
            // 离线/被墙：保留上一次结果；从未成功过就什么都不显示（不能凭空吓唬用户"时钟有问题"）。
        }
        finally
        {
            Interlocked.Exchange(ref _checking, 0);
            if (!_disposed)
            {
                try { await InvokeAsync(StateHasChanged); }
                catch { /* 电路已断开：没有可刷新的 UI */ }
            }
        }
    }

    /// <summary>把偏差说成人话："24 小时 0 分" / "3 分 20 秒" / "45 秒"。</summary>
    private static string Describe(TimeSpan skew)
    {
        var abs = skew.Duration();
        if (abs.TotalHours >= 1) return $"{(int)abs.TotalHours} 小时 {abs.Minutes} 分";
        if (abs.TotalMinutes >= 1) return $"{abs.Minutes} 分 {abs.Seconds} 秒";
        return $"{abs.TotalSeconds:F0} 秒";
    }

    public void Dispose()
    {
        _disposed = true;
        Clock.Synced -= OnClockSynced;
        _timer?.Dispose();
    }
}
