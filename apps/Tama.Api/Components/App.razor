@page "/"
@using static Microsoft.AspNetCore.Components.Web.RenderMode
<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Tama</title>
    <base href="/" />
    <link rel="stylesheet" href="_content/MudBlazor/MudBlazor.min.css" />
    <link rel="stylesheet" href="_content/Tama.UI/css/tama.css" />
    @* motion.css 必须排在 tama.css 之后（覆盖关系 + 同名 @keyframes 取后者） *@
    <link rel="stylesheet" href="_content/Tama.UI/css/motion.css" />
    <script>
        // 与 MAUI 宿主同款：首帧前恢复动效开关，否则会"先动一下再停"。
        // 主题恢复在 Tama.UI 的 MainLayout 里走 ThemeState.InitAsync（Server 宿主无内联兜底）。
        // 这里的 tamaPref 与 MAUI 宿主 index.html 里的那份是同一个约定：改名前的
        // keyguard-* 键读到就前移到 tama-*，别让用户的设置因为改名被重置。
        function tamaPref(key) {
            try {
                var v = localStorage.getItem('tama-' + key);
                if (v !== null) return v;
                var legacy = localStorage.getItem('keyguard-' + key);
                if (legacy !== null) {
                    localStorage.setItem('tama-' + key, legacy);
                    localStorage.removeItem('keyguard-' + key);
                }
                return legacy;
            } catch (e) { return null; }
        }
        (function () {
            var m = 'full';
            try { m = tamaPref('motion') === 'off' ? 'off' : 'full'; } catch (e) { }
            if (m === 'off') document.documentElement.classList.add('tm-motion-off');
        })();
    </script>
    <HeadOutlet @rendermode="InteractiveServer" />
</head>
<body>
    @* 复用 Tama.UI 的 Router（与 MAUI Hybrid 同一套页面/布局）。
       Server 宿主没有原生外壳：IHostIntegration 注册为 NoOpHostIntegration，主题等宿主调用静默降级。

       ⚠ prerender: false 是**必须**的，不是性能开关。开着预渲染时，服务端会先把整棵组件树
       静态渲染一遍，于是"进程内已解锁"这个状态会把已登录的 shell 渲进 SSR：
         · MainLayout 里 / → /vault 的归位会变成 HTTP 302，而 /vault 在 Server 宿主上没有
           服务端端点（页面路由全在客户端）→ 浏览器整页刷新直接 404（实测）；
         · 已登录 shell 在 SSR 里再渲一遍还会撞上 section 订阅冲突
           （InvalidOperationException: There is already a subscriber to the content with
           the given section ID 'System.Object'）→ 整页刷新 500（实测）。
       关掉预渲染后，SSR 只输出一个岛占位，门禁判定与路由全在电路里跑，两个问题一起消失。
       代价：浏览器宿主首帧会空白到电路连上（本机回环，百毫秒级）。MAUI 宿主不走这条路径。 *@
    <Tama.UI.Main @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="_content/Tama.UI/scripts/clipboard.js"></script>
    <script src="_content/Tama.UI/scripts/theme.js"></script>
    <script src="_content/Tama.UI/scripts/scrollbar.js"></script>
    <script src="_content/Tama.UI/scripts/motion.js"></script>
    @* 小屏外壳：底栏胶囊的抽屉开关 + 左右滑动切页（见 wwwroot/scripts/shell.js） *@
    <script src="_content/Tama.UI/scripts/shell.js"></script>
    <script src="_framework/blazor.web.js"></script>
</body>
</html>
