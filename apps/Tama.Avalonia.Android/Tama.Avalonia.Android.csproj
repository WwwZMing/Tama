<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Android 头（Avalonia 单视图宿主）。

    前置条件：`dotnet workload install android` + Android SDK + JDK。
    ⚠ 刻意**不进** Tama.slnx：没有装 android workload 的机器上整解决方案会直接构建失败，
       而 Windows 侧的日常构建不该被移动端工具链拖住。单独构建：
         dotnet build apps/Tama.Avalonia.Android -c Release
  -->

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net11.0-android</TargetFramework>
    <SupportedOSPlatformVersion>26.0</SupportedOSPlatformVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <RootNamespace>Tama.Avalonia.Android</RootNamespace>
    <!-- 与 MAUI 时代保持一致：应用身份不变，已装机的数据目录/授权才不会分裂 -->
    <ApplicationId>com.tama.app</ApplicationId>
    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
    <AndroidPackageFormat>apk</AndroidPackageFormat>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>
    <DebugType Condition="'$(Configuration)' == 'Release'">none</DebugType>

    <!--
      手动 adb install 的 APK 必须自包含。

      .NET Android 的 Debug 默认启用 Fast Deployment：APK 只是壳，应用程序集由
      `dotnet build -t:Install` 另外推送。直接 adb install 会留下空覆盖目录，
      先表现为缺 QRCoder，随后 CoreCLR 因找不到运行时文件直接 SIGABRT。
      这里始终把程序集打进 APK，牺牲一点 Debug 包体积，换取可验证、可转发的独立产物。
    -->
    <EmbedAssembliesIntoApk>true</EmbedAssembliesIntoApk>

    <!--
      手机上的 GC 微调（2026-11-14，真机实测）。

      Android 上**没有别的 GC 可换**：Satori 是整套替换运行时、且 Android 只支持 PublishAot=true；
      APK 里也只有 libcoreclr.so + libclrjit.so（没有 libclrgc/libclrgcexp），
      所以 GCName 这个开关在这里没有目标可指。能调的就是默认 Workstation GC 的几个旋钮。

      ✅ System.GC.ConserveMemory=3（见下面 ItemGroup）—— 让 GC 早回收、少留闲置容量。
         实测（5 次冷启动取中位数）：575ms vs 基线 578ms（等于没变化），
         TOTAL PSS 308MB vs 基线 326MB（约 -18MB）。留着。

      ❌ ConcurrentGarbageCollection=false —— 试过并**放弃**：
         578ms → 711ms，冷启动慢了 23%（阻塞式 GC 不能和启动期的分配重叠）。
         单窗口 UI 的那点后台线程开销，抵不上启动肉眼可见地变慢。

      没开 Server GC（UI 进程只有反效果），也没设 GCHeapHardLimit（设不好会被 OOM 杀掉）。
    -->
  </PropertyGroup>

  <ItemGroup>
    <RuntimeHostConfigurationOption Include="System.GC.ConserveMemory" Value="3" />
  </ItemGroup>

  <ItemGroup>
    <AndroidResource Include="Icon.png">
      <Link>Resources\drawable\Icon.png</Link>
    </AndroidResource>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia.Android" Version="12.1.6" />
    <PackageReference Include="Xamarin.AndroidX.Core.SplashScreen" Version="1.0.1.15" />
    <!-- 生物识别弹窗（BiometricPrompt）。包名带 Xamarin. 前缀，命名空间才是 AndroidX.Biometric。
         版本沿用 MAUI 时代验证过的 1.1.0.33（与本机 nuget 缓存一致）。 -->
    <PackageReference Include="Xamarin.AndroidX.Biometric" Version="1.1.0.33" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Tama.Avalonia\Tama.Avalonia.csproj" />
  </ItemGroup>

</Project>
