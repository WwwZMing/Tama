<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android" android:installLocation="auto">
	<uses-permission android:name="android.permission.INTERNET" />
	<!-- 生物识别（指纹/面容）弹窗；没有硬件的机型仍可用锁屏 PIN 走 DeviceCredential 分支 -->
	<uses-permission android:name="android.permission.USE_BIOMETRIC" />
	<uses-feature android:name="android.hardware.fingerprint" android:required="false" />
	<!--
		自动填充服务（com.tama.app.TamaAutofillService）不在这里手写：
		它由 TamaAutofillService 上的 [Service] / [IntentFilter] / [MetaData] 特性生成，
		两处同时声明会让清单里出现重复的 service 节点。
	-->
	<application android:label="Tama" android:icon="@drawable/Icon" />
</manifest>
