<?xml version="1.0" encoding="utf-8" ?>
<resources>

  <style name="MyTheme">
  </style>

  <style name="MyTheme.NoActionBar" parent="@style/Theme.AppCompat.NoActionBar">
    <item name="android:windowActionBar">false</item>
    <!-- 不要 @null：系统启动屏收起后、Avalonia 首帧出来前，@null 会露出一帧纯黑。
         指到 splash_screen 之后，这 500~700ms 里一直是"品牌底色 + 图标"，不再黑闪。 -->
    <item name="android:windowBackground">@drawable/splash_screen</item>
    <item name="android:windowNoTitle">true</item>
    <!--
      Android 12+ 的系统启动屏（2026-11-14 改）。

      以前这里指 @drawable/avalonia_anim —— 那是 Avalonia 模板自带的**Avalonia logo 动画**，
      冷启动第一眼看到的是别人的标志。现在换成我们自己的图标（Icon.png 就是 Tama 的 T 环）。
      同时删掉了 windowSplashScreenAnimationDuration：静态图标没有动画时长可言。
    -->
    <item name="android:windowSplashScreenBackground">@color/splash_background</item>
    <!-- 启动图标：**只动这一层**，与桌面图标（@drawable/icon）无关。
         splash_logo.png 是拿 Icon.png 做圆形 alpha 裁切得到的（图形本身没重画），
         所以冷启动看到的是"圆形品牌图标"，不会再有白底方块。 -->
    <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
    <item name="postSplashScreenTheme">@style/MyTheme.Main</item>

  </style>
  <style name="MyTheme.Main"
         parent ="MyTheme.NoActionBar">
    <item name="android:windowIsTranslucent">true</item>
  </style>
</resources>
